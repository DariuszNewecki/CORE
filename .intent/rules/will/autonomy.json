{
    "$schema": "META/rule_document.schema.json",
    "kind": "rule_document",
    "metadata": {
        "id": "rules.will.autonomy",
        "title": "Autonomous Lane Control",
        "version": "1.7.0",
        "authority": "policy",
        "phase": "runtime",
        "status": "active"
    },
    "rules": [
        {
            "id": "autonomy.tracing.mandatory",
            "statement": "All non-trivial autonomous decisions MUST produce an inspectable trace in the Decision Log.",
            "authority": "policy",
            "phase": "execution",
            "enforcement": "reporting"
        },
        {
            "id": "autonomy.remediation.min_confidence_floor",
            "statement": "The RemediationMap MUST NOT dispatch any entry whose confidence value is below 0.80. Entries below this threshold MUST NOT produce Proposals regardless of their status field.",
            "authority": "policy",
            "phase": "runtime",
            "enforcement": "blocking"
        },
        {
            "id": "autonomy.reasoning.policy_alignment",
            "statement": "The PlannerAgent MUST explicitly reference its governing quality assurance policy.",
            "authority": "policy",
            "phase": "runtime",
            "enforcement": "reporting",
            "scope": {
                "paths": ["src/will/agents/planner_agent.py"]
            }
        }
    ]
}
