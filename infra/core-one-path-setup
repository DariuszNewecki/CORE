#!/bin/bash
# infra/core-one-path-setup — host setup for the one-path flow (governor ruling 2026-10-12).
#
# After this, a change goes live when the governor merges its pull request into main on GitHub:
# the runner (account core-runner, on a 2-minute timer) deploys it with core-deploy, which also
# applies merged law through core-law using the deployed commit's own code.
#
# Usage, as darek, from /opt/dev/CORE:
#   sudo bash infra/core-one-path-setup --ref <sha on GitHub> --dry-run
#   sudo bash infra/core-one-path-setup --ref <sha on GitHub>
#
# The installed scripts update themselves after each deploy (core-deploy's
# self-update). Run this again only when a merge changes it, infra/systemd/ or the
# other setup scripts: core-deploy then refuses that merge and names this command.
#
# What it changes on the host (each step is skipped when already right):
#  1. installs /usr/local/sbin/{core-deploy,core-pipeline,core-sandbox-check} from GitHub at <sha>
#     (never from the development tree), root:root 0755, printing each sha256;
#  2. creates the system account core-runner (no login shell, locked password, own group only);
#  3. /var/lib/core-pipeline (core-runner 0755): the runner's state, logs and status.json;
#  4. /etc/core/pipeline.conf (root:core-runner 0640): repository, the governor's GitHub login,
#     branch main; and, if you paste one, a GitHub token that may open issues
#     (/etc/core/pipeline-github-token, root:core-runner 0640); DEPLOY_KEY names the key that
#     pushes `live` (/etc/core/pipeline-deploy-key, core-runner 0600, made by the governor);
#  5. /opt/core/etc/deploy.conf: DEPLOY_BRANCH=main (core-deploy then deploys only commits on main),
#     and, each when missing, BACKUP_COMMAND (the dump core-deploy takes before a migration),
#     PSQL_COMMAND and RESTORE_IMAGE (the dump's restore check, #1113);
#  6. /etc/sudoers.d/core-runner, checked with visudo: core-runner may run exactly
#     /usr/local/sbin/core-deploy as root and /usr/local/sbin/core-sandbox-check (no arguments)
#     as core, without a password. Nothing else, no shell;
#  7. removes /etc/sudoers.d/core-law: the merge is the only approval of law, and the governor
#     (core-darek) holds no sudo (ADR-068 amendment 2026-10-15);
#  8. core-pipeline.service + core-pipeline.timer (every 2 minutes), enabled and started;
#  8b. removes core-promote-propose.service + .timer: without a token it never ran
#     (ceremony cut #1255, governor 2026-10-23); core-claude opens the promotion daily;
#  8c. core-qdrant-backup.service + .timer (daily 02:00, before the 02:30 VM backup):
#     /usr/local/sbin/core-qdrant-backup (from infra/scripts/ at <sha>) snapshots every Qdrant
#     collection into /var/lib/core-qdrant-backup, keeping the last 7 runs (#1081);
#  9. probes: what core-runner may run with sudo, and that it cannot read /opt/core/etc.
set -euo pipefail

REPO="DariuszNewecki/CORE"
GOVERNOR_GITHUB="DariuszNewecki"
REF=""
DRY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ref) REF="$2"; shift 2 ;;
    --governor-github) GOVERNOR_GITHUB="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
[[ $EUID -eq 0 ]] || { echo "run it as root (sudo)" >&2; exit 1; }
[[ "$REF" =~ ^[0-9a-f]{40}$ ]] || { echo "--ref must be a full 40-character sha" >&2; exit 1; }

say() { echo "$*"; }
do_() { if [[ $DRY -eq 1 ]]; then echo "  would: $*"; else echo "  do: $*"; "$@"; fi; }
write_file() {  # path owner group mode  (content on stdin)
  local path="$1" owner="$2" group="$3" mode="$4" tmp
  tmp="$(mktemp)"; cat > "$tmp"
  if [[ -f "$path" ]] && cmp -s "$tmp" "$path"; then
    say "  ok: $path"
  elif [[ $DRY -eq 1 ]]; then
    say "  would write: $path ($owner:$group $mode, sha256 $(sha256sum "$tmp" | cut -c1-16))"
  else
    install -o "$owner" -g "$group" -m "$mode" "$tmp" "$path"
    say "  wrote: $path"
  fi
  rm -f "$tmp"
}

# The GitHub token for failure reports, asked only at a terminal: core-deploy
# runs this script with empty stdin after a merge (governor 2026-10-15), where
# `read` would fail under set -e and refuse the deploy.
ask_token() {  # token-file
  local path="$1" token
  if [[ -f "$path" ]]; then
    say "  ok: GitHub token present"
  elif [[ $DRY -eq 1 ]]; then
    say "  would ask for a GitHub token (issues: write) for failure reports; Enter skips"
  elif [[ ! -t 0 ]]; then
    say "  skipped (no terminal): failures will be written to status.json only"
  else
    read -r -s -p "  GitHub token that may open issues (Enter to skip): " token; echo
    if [[ -n "$token" ]]; then
      printf '%s\n' "$token" | write_file "$path" root core-runner 0640
    else
      say "  skipped: failures will be written to status.json only"
    fi
  fi
}

say "1. scripts from GitHub at $REF"
for name in core-deploy core-pipeline core-sandbox-check; do
  url="https://raw.githubusercontent.com/$REPO/$REF/infra/$name"
  body="$(mktemp)"
  curl -fsSL "$url" -o "$body"
  say "  $name sha256 $(sha256sum "$body" | cut -d' ' -f1)"
  write_file "/usr/local/sbin/$name" root root 0755 < "$body"
  rm -f "$body"
done

# The Qdrant snapshot backup (#1081) lives under infra/scripts/.
url="https://raw.githubusercontent.com/$REPO/$REF/infra/scripts/core-qdrant-backup"
body="$(mktemp)"
curl -fsSL "$url" -o "$body"
say "  core-qdrant-backup sha256 $(sha256sum "$body" | cut -d' ' -f1)"
write_file /usr/local/sbin/core-qdrant-backup root root 0755 < "$body"
rm -f "$body"

say "2. account core-runner"
if id core-runner >/dev/null 2>&1; then
  extra="$(id -nG core-runner | tr ' ' '\n' | grep -vx core-runner || true)"
  [[ -z "$extra" ]] || { echo "core-runner is in other groups: $extra" >&2; exit 1; }
  say "  ok: exists, own group only"
else
  do_ useradd --system --user-group --no-create-home --home-dir /var/lib/core-pipeline \
      --shell /usr/sbin/nologin core-runner
  do_ passwd --lock core-runner
fi

say "3. /var/lib/core-pipeline"
do_ install -d -o core-runner -g core-runner -m 0755 /var/lib/core-pipeline

say "4. /etc/core/pipeline.conf"
do_ install -d -o root -g root -m 0755 /etc/core
write_file /etc/core/pipeline.conf root core-runner 0640 <<EOF
# one-path flow (governor ruling 2026-10-12); read by core-pipeline as core-runner
GITHUB_REPO=$REPO
GOVERNOR_GITHUB=$GOVERNOR_GITHUB
BRANCH=main
TOKEN_FILE=/etc/core/pipeline-github-token
DEPLOY_KEY=/etc/core/pipeline-deploy-key
EOF
if [[ -f /etc/core/pipeline-deploy-key ]]; then
  say "  ok: deploy key present"
else
  say "  no deploy key: live stays where it is (status.json says so)"
fi
ask_token /etc/core/pipeline-github-token

say "5. /opt/core/etc/deploy.conf: DEPLOY_BRANCH=main"
if grep -qx 'DEPLOY_BRANCH=main' /opt/core/etc/deploy.conf 2>/dev/null; then
  say "  ok"
elif [[ $DRY -eq 1 ]]; then
  say "  would set DEPLOY_BRANCH=main"
else
  sed -i '/^DEPLOY_BRANCH=/d' /opt/core/etc/deploy.conf
  echo 'DEPLOY_BRANCH=main' >> /opt/core/etc/deploy.conf
  say "  set"
fi
# The database commands core-deploy needs for a migration, each added when missing. Built
# from the services' own DATABASE_URL (values never printed); the server's own tools (in its
# container) when there is one, so versions always match.
db_url=""
db_facts() {
  [[ -n "$db_url" ]] && return 0
  db_url="$(grep -E '^DATABASE_URL=' /opt/core/etc/secrets.env | head -1 | cut -d= -f2- | tr -d '"')"
  db_url="${db_url/postgresql+asyncpg:/postgresql:}"
  read -r db_user db_name < <(python3 -c 'import sys,urllib.parse as u; p=u.urlsplit(sys.argv[1]); print(p.username, p.path.lstrip("/"))' "$db_url")
  in_container=0
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx core_postgres_db; then in_container=1; fi
}
add_conf() {  # key, value, what it is
  if [[ $DRY -eq 1 ]]; then
    say "  would add $1 ($3)"
  else
    printf '%s=%s\n' "$1" "$2" >> /opt/core/etc/deploy.conf
    say "  added $1 ($3)"
  fi
}
# BACKUP_COMMAND: the dump core-deploy takes before a migration.
if grep -q '^BACKUP_COMMAND=.*{out}' /opt/core/etc/deploy.conf 2>/dev/null; then
  say "  ok: BACKUP_COMMAND present"
else
  db_facts
  if [[ $in_container -eq 1 ]]; then
    add_conf BACKUP_COMMAND "docker exec core_postgres_db pg_dump -U $db_user -Fc $db_name > {out}" \
      "pg_dump inside the core_postgres_db container, database $db_name"
  else
    add_conf BACKUP_COMMAND "pg_dump -Fc --dbname=$db_url > {out}" "the host's pg_dump, database $db_name"
  fi
fi
# PSQL_COMMAND: psql on the live database, SQL on stdin; core-deploy counts each table's
# rows with it, read-only, right after the dump (#1113).
if grep -q '^PSQL_COMMAND=.' /opt/core/etc/deploy.conf 2>/dev/null; then
  say "  ok: PSQL_COMMAND present"
else
  db_facts
  if [[ $in_container -eq 1 ]]; then
    add_conf PSQL_COMMAND "docker exec -i core_postgres_db psql -U $db_user -d $db_name" \
      "psql inside the core_postgres_db container, database $db_name"
  else
    add_conf PSQL_COMMAND "psql --dbname=$db_url" "the host's psql, database $db_name"
  fi
fi
# RESTORE_IMAGE: the database server's own image; core-deploy restores each pre-migration
# dump into a throwaway container of it (no network, removed afterwards) (#1113).
if grep -q '^RESTORE_IMAGE=.' /opt/core/etc/deploy.conf 2>/dev/null; then
  say "  ok: RESTORE_IMAGE present"
else
  db_facts
  if [[ $in_container -eq 1 ]]; then
    image="$(docker inspect --format '{{.Config.Image}}' core_postgres_db)"
    add_conf RESTORE_IMAGE "$image" "the core_postgres_db container's image"
  else
    say "  no RESTORE_IMAGE: no core_postgres_db container; core-deploy only lists each dump and warns"
  fi
fi

say "6. /etc/sudoers.d/core-runner"
rules="$(mktemp)"
cat > "$rules" <<'EOF'
# one-path flow (governor ruling 2026-10-12). Installed by infra/core-one-path-setup.
# core-runner deploys merged commits and probes them. Nothing else.
Defaults:core-runner env_reset, !requiretty
core-runner ALL=(root) NOPASSWD: /usr/local/sbin/core-deploy
core-runner ALL=(core) NOPASSWD: /usr/local/sbin/core-sandbox-check ""
EOF
visudo -c -q -f "$rules"
write_file /etc/sudoers.d/core-runner root root 0440 < "$rules"
rm -f "$rules"

say "7. /etc/sudoers.d/core-law: removed (the merge approves law)"
if [[ -e /etc/sudoers.d/core-law ]]; then
  do_ rm -f /etc/sudoers.d/core-law
else
  say "  ok: none"
fi

say "8. core-pipeline timer"
write_file /etc/systemd/system/core-pipeline.service root root 0644 <<'EOF'
# one-path flow (governor ruling 2026-10-12). Installed by infra/core-one-path-setup.
[Unit]
Description=CORE post-merge runner: make the governor's merges into main live
After=network-online.target

[Service]
Type=oneshot
User=core-runner
Group=core-runner
ExecStart=/usr/local/sbin/core-pipeline
UMask=0022
SyslogIdentifier=core-pipeline
EOF
write_file /etc/systemd/system/core-pipeline.timer root root 0644 <<'EOF'
[Unit]
Description=CORE post-merge runner, every 2 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOF
do_ systemctl daemon-reload
do_ systemctl enable --now core-pipeline.timer

say "8b. core-promote-propose timer removed (#1255)"
if [[ -e /etc/systemd/system/core-promote-propose.timer || -e /etc/systemd/system/core-promote-propose.service ]]; then
  do_ systemctl disable --now core-promote-propose.timer
  do_ rm -f /etc/systemd/system/core-promote-propose.timer /etc/systemd/system/core-promote-propose.service
  do_ systemctl daemon-reload
fi

say "8c. core-qdrant-backup timer"
write_file /etc/systemd/system/core-qdrant-backup.service root root 0644 <<'EOF'
# Qdrant snapshot backup (#1081). Installed by infra/core-one-path-setup.
# Restore: docs/recovery.md, "Vector store: snapshots".
[Unit]
Description=CORE Qdrant snapshot backup: every collection, last 7 runs kept
After=network-online.target docker.service

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=core-qdrant-backup
StateDirectoryMode=0750
UMask=0027
# QDRANT_URL (and QDRANT_API_KEY if set) as the services see them.
EnvironmentFile=-/opt/core/etc/core.env
ExecStart=/usr/local/sbin/core-qdrant-backup backup --dir /var/lib/core-qdrant-backup --keep 7
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
SyslogIdentifier=core-qdrant-backup
EOF
write_file /etc/systemd/system/core-qdrant-backup.timer root root 0644 <<'EOF'
[Unit]
Description=CORE Qdrant snapshot backup, daily before the VM backup

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
do_ systemctl daemon-reload
do_ systemctl enable --now core-qdrant-backup.timer

say "9. probes"
if [[ $DRY -eq 1 ]]; then
  say "  would: list core-runner's sudo rights; check it cannot read /opt/core/etc"
else
  sudo -l -U core-runner | sed -n '/may run/,$p'
  if runuser -u core-runner -- ls /opt/core/etc >/dev/null 2>&1; then
    echo "  FAILED: core-runner can read /opt/core/etc" >&2; exit 1
  fi
  say "  denied as expected: core-runner reads /opt/core/etc"
fi
say "$([[ $DRY -eq 1 ]] && echo 'plan only; nothing changed.' || echo 'done.')"
