# infra/systemd/d2/core.env.example -> /opt/core/etc/core.env (core:core 0600).
# Values mirror today's .env (2026-10-11). NON-SECRET settings for every CORE unit (EnvironmentFile=). Never put DATABASE_URL's
# password, CORE_MASTER_KEY or API keys here: those go in CORE_SECRETS_FILE (#962).
CORE_ENV=development
LOG_LEVEL=WARNING
# CORE's own clone (code only) and the law beside it, written only by core-law (ruling A).
REPO_PATH=/opt/core/repo
MIND=/opt/core/law/.intent
SPECS=/opt/core/law/.specs
# Where CORE's clone takes commits from (fast-forward only); also read by core-deploy.
CORE_UPSTREAM_URL=https://github.com/DariuszNewecki/CORE.git
CORE_SECRETS_FILE=/opt/core/etc/secrets.env
QDRANT_URL=http://192.168.20.22:6333
