# infra/systemd/d2/core-api.service — the API on loopback (ADR-054 D3) under the release runtime
# (ADR-132 D10 · D2), and on CORE's Unix socket, the only route to governor acts (ADR-132 D10.3 as
# amended). /run/core/api is made by tmpfiles (core-runtime-setup): owned by core, group core-gov,
# setgid, so the socket (mode 0660) is reachable by core-gov members (the governor) and nobody else.
[Unit]
Description=CORE API Server (loopback only, release runtime)
After=network.target core-daemon.service
PartOf=core-daemon.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/opt/core/run
EnvironmentFile=/opt/core/etc/core.env
Environment=PATH=/opt/core/current/venv/bin:/usr/local/bin:/usr/bin:/bin
# A socket left by a crash would make api.serve refuse to start; the directory is core's own.
ExecStartPre=/bin/rm -f /run/core/api/api.sock
ExecStart=/opt/core/current/venv/bin/python -I -m api.serve \
    --uds /run/core/api/api.sock \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=core-api

[Install]
WantedBy=default.target
