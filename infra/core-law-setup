def requirements_from_lock(lock_bytes: bytes) -> str:
    """The runtime packages of the lock, pinned with all their file hashes.

    Only packages in the ``main`` group: core-law runs ``law apply`` and its
    data checks, never the audit tools, test runners or doc builders of the
    ``dev`` group. Unlike core-deploy (the services run mypy and ruff), so
    fewer packages and fewer start-up hooks: dev packages ship ``.pth``
    files (coverage's process hook, sphinx namespace shims) that the venv
    check refuses. A package listed without groups counts as ``main``.
    """
    lock = tomllib.loads(lock_bytes.decode())
    lines = []
    for package in lock.get("package", []):
        if "main" not in package.get("groups", ["main"]):
            continue
        hashes = [f["hash"] for f in package.get("files", []) if f.get("hash")]
        if not hashes:
            raise Refused(f"poetry.lock has no hashes for {package['name']}")
        spec = f"{package['name']}=={package['version']}"
        if package.get("markers") and isinstance(package["markers"], str):
            spec += f" ; {package['markers']}"
        lines.append(spec + "".join(f" \\\n    --hash={h}" for h in hashes))
    return "\n".join(lines) + "\n"


@dataclass(frozen=True)
class Release:
    """The live release as core-deploy left it: its record, wheel and lock."""

    sha: str
    record: bytes  # core-release.json, verbatim
    wheel_sha256: str
    wheel: Path
    lock: Path


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def live_release(layout: Layout) -> Release:
    """The release ``current`` points at, its wheel checked against its record."""
    link = layout.current
    if not link.is_symlink():
        raise Refused(f"{link} is not a symlink to a release: nothing is deployed")
    release = link.resolve()
    sha = release.name
    if release.parent != layout.releases.resolve() or not re.fullmatch(
        r"[0-9a-f]{40}", sha
    ):
        raise Refused(f"{link} points at {release}, not at a release")
    record_path = release / "venv" / "core-release.json"
    try:
        record = record_path.read_bytes()
        meta = json.loads(record)
    except (OSError, ValueError) as exc:
        raise Refused(f"{record_path} unreadable: {exc}") from exc
    wheel_sha = meta.get("wheel_sha256") if isinstance(meta, dict) else None
    if meta.get("sha") != sha or not re.fullmatch(r"[0-9a-f]{64}", str(wheel_sha)):
        raise Refused(f"{record_path} does not describe release {sha}")
    dist = release / "dist"
    wheels = sorted(dist.glob("*.whl"))
    lock = dist / "poetry.lock"
    if len(wheels) != 1 or not lock.is_file():
        raise Refused(
            f"release {sha} keeps no wheel and lock in {dist} (deployed before "
            "core-deploy kept them): deploy a later commit, then run this again"
        )
    actual = sha256_file(wheels[0])
    if actual != wheel_sha:
        raise Refused(
            f"{wheels[0].name} has sha256 {actual}, but core-release.json says "
            f"{wheel_sha}: not the wheel core-deploy built"
        )
    return Release(sha, record, str(wheel_sha), wheels[0], lock)


def site_packages(venv: Path) -> Path:
    found = sorted(venv.glob("lib/python3*/site-packages"))
    if len(found) != 1:
        raise Refused(f"no single site-packages under {venv}")
    return found[0]


def installed_version(venv: Path) -> str | None:
    try:
        sp = site_packages(venv)
    except Refused:
        return None
    for meta in sp.glob("core_runtime-*.dist-info/METADATA"):
        for line in meta.read_text(errors="replace").splitlines():
            if line.startswith("Version: "):
                return line.split(": ", 1)[1].strip()
    return None


def installed_wheel_sha256(venv: Path) -> str | None:
    """The sha256 pip recorded for the installed core-runtime wheel file."""
    try:
        sp = site_packages(venv)
    except Refused:
        return None
    found = sorted(sp.glob("core_runtime-*.dist-info/direct_url.json"))
    if len(found) != 1:
        return None
    try:
        info = json.loads(found[0].read_text())
        return str(info["archive_info"]["hashes"]["sha256"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def venv_problems(venv: Path, release: Release) -> list[str]:
    """Reasons the venv is not exactly the release's code; empty when it is."""
    problems: list[str] = []
    try:
        sp = site_packages(venv)
    except Refused as exc:
        return [str(exc)]
    installed = installed_wheel_sha256(venv)
    if installed != release.wheel_sha256:
        problems.append(
            f"core-runtime wheel sha256 {installed} installed, not release "
            f"{release.sha}'s {release.wheel_sha256}"
        )
    record = venv / "core-release.json"
    if not record.is_file() or record.read_bytes() != release.record:
        problems.append(f"core-release.json is not release {release.sha}'s")
    for pth in sp.glob("*.pth"):
        if pth.name != "distutils-precedence.pth":
            problems.append(f"{pth.name}: a .pth file can load code from elsewhere")
    for direct in sp.glob("*.dist-info/direct_url.json"):
        if not direct.parent.name.startswith("core_runtime-"):
            problems.append(
                f"{direct.parent.name}: installed from a path or URL, not the lock"
            )
    admin = venv / "bin" / "core-admin"
    if not admin.is_file():
        problems.append("bin/core-admin is missing")
    return problems


