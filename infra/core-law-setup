@dataclass
class Setup:
    layout: Layout
    host: Host
    governor: str
    apply: bool
    # Where pip finds the dependency wheels; empty means PyPI. Tests point it
    # at a local folder. core-runtime itself is always the release's file.
    pip_source: tuple[str, ...] = ()
    log: list[str] = field(default_factory=list)
    failures: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)
    # Nothing deployed yet (a fresh host, #1085): the venv waits for the
    # first core-deploy; everything else, the release law included, is done.
    undeployed: bool = False

    def say(self, message: str) -> None:
        self.log.append(message)
        print(message, flush=True)

    def act(self, message: str) -> bool:
        """Announce a change; True when it should be made."""
        self.say(("  do: " if self.apply else "  would: ") + message)
        return self.apply

    # -- preflight ---------------------------------------------------------

    def preflight(self) -> None:
        if not self.host.is_root():
            raise Refused("run it as root (sudo)")
        if self.governor in NOT_A_GOVERNOR or self.host.account(self.governor) is None:
            raise Refused(
                f"{self.governor!r} is not the Governor's account "
                "(the register binds it to another role, or it does not exist)"
            )
        admin = [
            g for g in self.host.groups_of(self.governor) if g in ROOT_EQUIVALENT_GROUPS
        ]
        if admin:
            raise Refused(
                f"the governor account {self.governor!r} administers the host "
                f"(member of {', '.join(admin)}); host administration is not a "
                "CORE role (rule 6)"
            )
        if not (self.layout.repo / ".intent").is_dir():
            raise Refused(f"no .intent/ in {self.layout.repo}")
        existing = self.host.account(CUSTODIAN)
        if existing is not None and existing.pw_shell not in (
            "/usr/sbin/nologin",
            "/sbin/nologin",
            "/bin/false",
        ):
            raise Refused(f"{CUSTODIAN} exists with a login shell; not ours")

    # -- 0. ownership plan ------------------------------------------------------

    def _now(self, path: Path) -> str:
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            return "absent"
        except PermissionError:
            return "unreadable (not root)"
        user, group = self.host.owner(path)
        return f"{user}:{group} {stat.S_IMODE(info.st_mode):o}"

    def ownership_plan(self) -> None:
        self.say("0. ownership and modes: now -> after")
        repo, law = self.layout.repo, self.layout.law_root
        rows: list[tuple[Path, str]] = [
            *[(p, "root:root 755") for p in reversed(self.layout.ancestors)],
            (repo, f"root:{DEV_GROUP} 3775 (sticky)"),
            (repo / ".intent", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (repo / ".specs", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (repo / "CLAUDE.md", f"{CUSTODIAN}:{CUSTODIAN} 644"),
            (repo / ".claude", f"{CUSTODIAN}:{DEV_GROUP} 3775 (sticky)"),
            (repo / ".claude" / "settings.json", f"{CUSTODIAN}:{CUSTODIAN} 644"),
            (repo / ".claude" / "hooks", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (self.layout.core_root, "root:root 755"),
            (law, "root:root 755"),
            (law / ".intent", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (law / ".specs", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (self.layout.law_home, "root:root 755"),
            (self.layout.venv, "root:root 755"),
            (self.layout.home, f"{CUSTODIAN}:{CUSTODIAN} 700"),
            (self.layout.key, f"{CUSTODIAN}:{CUSTODIAN} 600 (kept if present)"),
            (self.layout.sudoers, "removed"),
        ]
        for path, target in rows:
            self.say(f"  {path!s:<45} {self._now(path):<26} -> {target}")

    # -- 5a. the repository's parents -----------------------------------------

    def ancestors(self) -> None:
        self.say("5a. the repository's parents: root-owned, not writable by others")
        for path in self.layout.ancestors:
            mode = stat.S_IMODE(path.stat().st_mode)
            owner = self.host.owner(path)[0]
            if owner == "root" and not mode & 0o022:
                continue
            # Whoever owns a parent can rename the repository away and put
            # another tree in its place; the sticky bit cannot stop that.
            if self.act(f"{path}: root:root 755 (was {self._now(path)})"):
                self.host.chown(path, "root", "root")
                os.chmod(path, 0o755)

    def bypass_report(self) -> None:
        self.say("5b. accounts that can bypass file permissions altogether")
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            groups = [
                g for g in self.host.groups_of(account) if g in ROOT_EQUIVALENT_GROUPS
            ]
            if not groups:
                self.say(f"  {account}: none")
                continue
            line = f"NOT PROTECTED from {account}: member of {', '.join(groups)}"
            if "sudo" in groups and set(groups) == {"sudo"}:
                line += " (root, but only with its password)"
            elif any(g != "sudo" for g in groups):
                line += " (root without any password)"
            self.warnings.append(line)
            self.say(f"  {line}")

    # -- 1. account ------------------------------------------------------------

    def account(self) -> None:
        self.say("1. account core-law")
        if self.host.account(CUSTODIAN) is not None:
            self.say("  ok: exists, no login shell")
            return
        if self.act("create system account core-law (no login, locked password)"):
            self.host.run(
                [
                    "useradd",
                    "--system",
                    "--user-group",
                    "--no-create-home",
                    "--home-dir",
                    str(self.layout.home),
                    "--shell",
                    "/usr/sbin/nologin",
                    CUSTODIAN,
                ]
            )
            self.host.run(["passwd", "--lock", CUSTODIAN])

    # -- 2. venv ---------------------------------------------------------------

    def directories(self) -> None:
        self.say("2a. /opt/core-law")
        for path, user, group, mode in (
            (self.layout.law_home, "root", "root", 0o755),
            (self.layout.build, "root", "root", 0o700),
            (self.layout.home, CUSTODIAN, CUSTODIAN, 0o700),
            (self.layout.home / ".ssh", CUSTODIAN, CUSTODIAN, 0o700),
            (self.layout.home / "scratch", CUSTODIAN, CUSTODIAN, 0o700),
        ):
            self._ensure_dir(path, user, group, mode)

    def _ensure_dir(self, path: Path, user: str, group: str, mode: int) -> None:
        if path.is_symlink():
            raise Refused(f"{path} is a symlink")
        exists = path.is_dir()
        right = (
            exists
            and self.host.owner(path) == (user, group)
            and (stat.S_IMODE(path.stat().st_mode) == mode)
        )
        if right:
            return
        if self.act(f"{path}: {user}:{group} {mode:o}"):
            path.mkdir(mode=mode, parents=True, exist_ok=True)
            self.host.chown(path, user, group)
            os.chmod(path, mode)

    def venv(self) -> None:
        link = self.layout.current
        if not link.is_symlink() and not link.exists():
            self.undeployed = True
            self.say(
                f"2b. venv: nothing deployed yet ({link} absent); skipped until "
                "the first core-deploy"
            )
            return
        release = live_release(self.layout)
        self.say(
            f"2b. venv: release {release.sha}, wheel {release.wheel.name} "
            f"sha256 {release.wheel_sha256} (checked against core-release.json)"
        )
        venv = self.layout.venv
        if venv.is_dir() and not venv_problems(venv, release):
            self.say("  ok: installed and verified")
            return
        requirements = requirements_from_lock(release.lock.read_bytes())
        if not self.act(
            f"install into {venv} itself (a venv records its own path), keeping the "
            "previous venv aside until the new one runs"
        ):
            return
        reqs = self.layout.build / "requirements.txt"
        reqs.write_text(requirements)
        # A root-owned copy, hashed again: what pip installs is what was checked.
        wheel = self.layout.build / release.wheel.name
        shutil.copyfile(release.wheel, wheel)
        if sha256_file(wheel) != release.wheel_sha256:
            raise Refused(f"{wheel} changed while it was copied")
        pinned = self.layout.build / "core-runtime.txt"
        pinned.write_text(f"{wheel} --hash=sha256:{release.wheel_sha256}\n")
        old = venv.with_name("venv.old")
        if venv.exists():
            if old.exists():
                shutil.rmtree(old)
            venv.rename(old)
        try:
            self.host.run(["/usr/bin/python3", "-I", "-m", "venv", str(venv)])
            pip = [
                str(venv / "bin" / "python"),
                "-I",
                "-m",
                "pip",
                "install",
                "--quiet",
                "--no-cache-dir",
                "--only-binary=:all:",
                "--require-hashes",
                "--no-deps",
            ]
            self.host.run([*pip, *self.pip_source, "-r", str(reqs)])
            self.host.run([*pip, "--no-index", "-r", str(pinned)])
            (venv / "core-release.json").write_bytes(release.record)
            problems = venv_problems(venv, release)
            if problems:
                raise Refused(
                    "the new venv is not the released code:\n  " + "\n  ".join(problems)
                )
            # The installed entry point itself, as the account that will run it.
            self.host.run(
                [str(venv / "bin" / "core-admin"), "law", "--help"],
                user=CUSTODIAN,
                cwd=self.layout.repo,
            )
        except (Refused, OSError) as exc:
            if venv.exists():
                shutil.rmtree(venv)
            if old.exists():
                old.rename(venv)  # same path again, so its entry points work again
                raise Refused(f"{exc}\n  the previous venv was restored") from exc
            raise
        self.say("  installed; core-admin law --help ran as core-law")

    # -- 3. key ----------------------------------------------------------------

    def key(self) -> None:
        self.say("3. ledger signing key")
        key = self.layout.key
        if key.exists():
            self.say(f"  ok: {key} exists and is kept")
        elif self.act(f"generate {key} as core-law (ed25519)"):
            self.host.run(
                [
                    "ssh-keygen",
                    "-q",
                    "-t",
                    "ed25519",
                    "-N",
                    "",
                    "-C",
                    NAMESPACE,
                    "-f",
                    str(key),
                ],
                user=CUSTODIAN,
            )
        if not key.exists():
            return
        public = key.with_suffix(".pub")
        if not public.exists() and self.act(f"re-derive {public} from the private key"):
            derived = self.host.run(
                ["ssh-keygen", "-y", "-f", str(key)], user=CUSTODIAN
            )
            public.write_bytes(derived.stdout)
        for path, mode in ((key, 0o600), (public, 0o644)):
            if (
                path.exists()
                and (
                    self.host.owner(path) != (CUSTODIAN, CUSTODIAN)
                    or stat.S_IMODE(path.stat().st_mode) != mode
                )
                and self.act(f"{path}: {CUSTODIAN} {mode:o}")
            ):
                self.host.chown(path, CUSTODIAN, CUSTODIAN)
                os.chmod(path, mode)
        if public.exists():
            self.say(
                "  allowed_signers line for the first law proposal "
                "(.intent/custody/allowed_signers):\n"
                f'    {CUSTODIAN} namespaces="{NAMESPACE}" {public.read_text().strip()}'
            )

    # -- 4. governed text ------------------------------------------------------

    def governed_text(self) -> None:
        self.say("4. governed text owned by core-law (files 0644, directories 0755)")
        changes = 0
        for rel in GOVERNED:
            top = self.layout.repo / rel
            if not top.exists():
                continue
            for path in [top, *top.rglob("*")] if top.is_dir() else [top]:
                if path.is_symlink():
                    raise Refused(f"symlink in governed text: {path}")
                mode = 0o755 if path.is_dir() else 0o644
                if self.host.owner(path) != (CUSTODIAN, CUSTODIAN) or (
                    stat.S_IMODE(path.stat().st_mode) != mode
                ):
                    changes += 1
                    if self.apply:
                        self.host.chown(path, CUSTODIAN, CUSTODIAN)
                        os.chmod(path, mode)
        self.act(f"{changes} path(s) re-owned") if changes else self.say("  ok")

    # -- 5. names --------------------------------------------------------------

    def names(self) -> None:
        self.say("5. names: sticky repository root; .claude core-law:core-dev 3775")
        repo = self.layout.repo
        for path, user, group, mode in (
            (repo, "root", DEV_GROUP, 0o3775),
            (repo / ".claude", CUSTODIAN, DEV_GROUP, 0o3775),
        ):
            if (
                path.is_dir()
                and (
                    self.host.owner(path) != (user, group)
                    or stat.S_IMODE(path.stat().st_mode) != mode
                )
                and self.act(f"{path}: {user}:{group} {mode:o}")
            ):
                self.host.chown(path, user, group)
                os.chmod(path, mode)
        protected = {Path(n).parts[0] for n in PROTECTED_NAMES}
        handed = []
        for entry in sorted(repo.iterdir()):
            if (
                entry.name in protected
                or (
                    NOT_HANDED_OVER.match(entry.name)
                    and entry.name not in HANDED_OVER_ENV_FILES
                )
                or entry.is_symlink()
                or not entry.is_file()
            ):
                continue
            owner, group = self.host.owner(entry)
            if owner != ASSISTANT:
                handed.append(entry)
                if self.apply:
                    self.host.chown(entry, ASSISTANT, group)
        if handed:
            self.act(
                f"{len(handed)} root-level file(s) to {ASSISTANT}, so its git checkout can "
                "replace them under the sticky bit: "
                + ", ".join(e.name for e in handed)
            )

    # -- 6. the law beside the release ----------------------------------------

    def release_law(self) -> None:
        self.say(f"6. {self.layout.law_root} (ADR-132 D10.13)")
        for path in (self.layout.core_root, self.layout.law_root):
            self._ensure_dir(path, "root", "root", 0o755)
        for name in (".intent", ".specs"):
            source = self.layout.repo / name
            target = self.layout.law_root / name
            if target.exists():
                same = tree_digest(source) == tree_digest(target)
                self.say(
                    f"  {name}: kept; {'identical to' if same else 'DIFFERS from'} the dev tree"
                )
                if not same:
                    self.failures.append(
                        f"{target} differs from the development tree (consistency check)"
                    )
                continue
            if self.act(f"seed {target} from {source}, owned by core-law"):
                shutil.copytree(source, target, symlinks=False)
                for path in [target, *target.rglob("*")]:
                    self.host.chown(path, CUSTODIAN, CUSTODIAN)
                    os.chmod(path, 0o755 if path.is_dir() else 0o644)

    # -- 6b. private names ---------------------------------------------------------

    def private_names(self) -> None:
        """The private-names hook's configuration, owned by core-law: the
        assistant reads it and cannot change, rename or delete it (governor
        2026-10-16). Seeded once from the assistant's own copy and the names
        file it points to; kept on every later run."""
        target = self.layout.private_names
        conf = target / "private-names.conf"
        self.say(f"6b. {target}: the private-names check's configuration")
        if conf.exists():
            for path in [target, *sorted(target.rglob("*"))]:
                mode = 0o755 if path.is_dir() else 0o644
                if self.host.owner(path) == (CUSTODIAN, CUSTODIAN) and (
                    stat.S_IMODE(path.lstat().st_mode) == mode
                ):
                    continue
                if self.act(f"make {path} core-law's, {mode:o}"):
                    self.host.chown(path, CUSTODIAN, CUSTODIAN)
                    os.chmod(path, mode)
            self.say(f"  {conf.name}: kept")
            return
        seed = self.layout.private_names_seed
        if not seed.is_file():
            self.say(
                f"  none: no {seed} to seed from; the assistant's commits and gh "
                "writes stay refused until there is one"
            )
            return
        values = {}
        for line in seed.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
        names = Path(values["NAMES"]) if values.get("NAMES") else None
        # Read as root: only the assistant's own regular files, never a link
        # that would copy someone else's file somewhere the assistant reads.
        for source in [seed, *([names] if names else [])]:
            if source.is_symlink() or not source.is_file():
                raise Refused(f"{source}: not a regular file; nothing seeded")
            if self.host.owner(source)[0] != ASSISTANT:
                raise Refused(f"{source}: not {ASSISTANT}'s; nothing seeded")
        if not self.act(f"seed {target} from {seed}, owned by core-law"):
            return
        target.mkdir(mode=0o755, exist_ok=True)
        if names:
            shutil.copyfile(names, target / "names.txt", follow_symlinks=False)
            values["NAMES"] = str(target / "names.txt")
        conf.write_text(
            "".join(f"{key}={value}\n" for key, value in values.items()),
            encoding="utf-8",
        )
        for path in [target, *sorted(target.rglob("*"))]:
            self.host.chown(path, CUSTODIAN, CUSTODIAN)
            os.chmod(path, 0o755 if path.is_dir() else 0o644)

    # -- 7. sudoers --------------------------------------------------------------

    def sudoers(self) -> None:
        self.say("7. sudoers: no law apply through sudo (the merge approves)")
        target = self.layout.sudoers
        if not target.exists():
            self.say("  ok: none")
            return
        if self.act(f"remove {target}"):
            target.unlink()

    # -- 7a. no auto-apply -------------------------------------------------------

    def remove_auto_apply(self) -> None:
        self.say("7a. timers: no law applies itself (auto-apply and digest removed)")
        units = self.layout.system_units
        present = [
            n for n in REMOVED_UNITS if (units / n).is_symlink() or (units / n).exists()
        ]
        if not present:
            self.say("  ok: none")
            return
        if self.act("systemctl disable --now " + " ".join(present) + "; delete them"):
            self.host.run(["systemctl", "disable", "--now", *present], check=False)
            for name in present:
                (units / name).unlink()
            self.host.run(["systemctl", "daemon-reload"])
            self.host.run(["systemctl", "reset-failed", *present], check=False)

    # -- 8. probes ---------------------------------------------------------------

    def probes(self) -> None:
        self.say("8. acceptance probes")
        if not self.apply:
            self.say("  would: run the probes after the changes")
            return
        repo = self.layout.repo
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            for label, script in PROBES:
                done = self.host.run(
                    ["sh", "-c", script], user=account, cwd=repo, check=False
                )
                # Undo whatever the probe managed, as root, whether or not it
                # "succeeded"; every undo is a no-op when nothing happened.
                self.host.run(["sh", "-c", PROBE_UNDO], cwd=repo, check=False)
                if done.returncode == 0:
                    self.failures.append(f"{account} could {label}")
                else:
                    self.say(f"  denied as expected: {account} {label}")
        moved = repo.with_name(repo.name + "-custody-probe")
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            done = self.host.run(
                ["mv", "-f", str(repo), str(moved)],
                user=account,
                cwd=repo.parent,
                check=False,
            )
            self.host.run(
                [
                    "sh",
                    "-c",
                    f'if [ -e "{moved}" ] && [ ! -e "{repo}" ]; then mv "{moved}" "{repo}"; fi',
                ],
                cwd=repo.parent,
                check=False,
            )
            if done.returncode == 0:
                self.failures.append(f"{account} could rename the repository")
            else:
                self.say(f"  denied as expected: {account} rename the repository")
        own = self.host.run(
            ["sh", "-c", "cp README.md .readme-probe && mv .readme-probe README.md"],
            user=ASSISTANT,
            cwd=repo,
            check=False,
        )
        if own.returncode != 0:
            self.failures.append(f"{ASSISTANT} cannot replace its own root-level file")
            self.host.run(["sh", "-c", "rm -f .readme-probe"], cwd=repo, check=False)
        else:
            self.say(f"  allowed as expected: {ASSISTANT} replaces README.md")

    def run_all(self) -> int:
        self.preflight()
        self.ownership_plan()
        self.account()
        self.directories()
        self.venv()
        self.key()
        self.governed_text()
        self.names()
        self.ancestors()
        self.bypass_report()
        self.release_law()
        self.private_names()
        self.sudoers()
        self.remove_auto_apply()
        self.probes()
        if self.warnings:
            self.say(
                "The sticky bit and ownership do not hold against:\n  "
                + "\n  ".join(self.warnings)
            )
        if self.failures:
            self.say("FAILED:\n  " + "\n  ".join(self.failures))
            return 1
        self.say(
            "done."
            if self.apply
            else "plan only; nothing changed. Re-run with --apply."
        )
        if self.undeployed:
            self.say(
                "Not yet installed: the venv. After the first "
                "core-deploy, run core-law-setup --apply again."
            )
        return 0


def main(
    argv: list[str] | None = None,
    host: Host | None = None,
    layout: Layout | None = None,
) -> int:
    parser = argparse.ArgumentParser(
        prog="core-law-setup", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument(
        "--governor",
        default=DEFAULT_GOVERNOR,
        help=f"the Governor's account, checked only (default: {DEFAULT_GOVERNOR})",
    )
    parser.add_argument("--repo", type=Path, default=Layout.repo)
    parser.add_argument("--apply", action="store_true", help="make the changes")
    args = parser.parse_args(argv)
    os.umask(0o022)
    setup = Setup(
        layout=layout or Layout(repo=args.repo),
        host=host or Host(),
        governor=args.governor,
        apply=args.apply,
    )
    try:
        return setup.run_all()
    except Refused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
