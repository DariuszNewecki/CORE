import subprocess
import sys
import tomllib
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path


CUSTODIAN = "core-law"
DEV_GROUP = "core-dev"
ASSISTANT = "core-claude"
SERVICES = "core"
PROBE_ACCOUNTS = ("core-claude", "core", "core-darek")
NOT_A_GOVERNOR = frozenset(
    {"root", "core", "core-claude", "core-darek", "core-law", "core-build", "nobody"}
)
GOVERNED = (".intent", ".specs", "CLAUDE.md", ".claude/settings.json", ".claude/hooks")
PROTECTED_NAMES = (".intent", ".specs", "CLAUDE.md", ".claude")
# Root-level files never handed to the assistant: the services' secrets.
NOT_HANDED_OVER = re.compile(r"^(\.env.*|\.secrets)$")
# Committed, non-secret files that the exclusion above would otherwise catch.
# Allowed by name only; every other .env* file stays with its owner.
HANDED_OVER_ENV_FILES = frozenset({".env.example", ".env.test"})
GITHUB_RAW = "https://raw.githubusercontent.com/DariuszNewecki/CORE"
PYPI = "https://pypi.org/pypi/core-runtime"
NAMESPACE = "core-law-ledger"
PROBES = (
    ("write .intent", "touch .intent/.custody-probe"),
    ("rename .intent", "mv .intent .intent-custody-probe"),
    (
        "replace CLAUDE.md",
        "cp CLAUDE.md .claude-md-probe && mv .claude-md-probe CLAUDE.md",
    ),
    ("write .claude/settings.json", "touch .claude/settings.json"),
)
# Groups whose members can change any file without file permissions: root
# with a password (sudo) or without one (docker, lxd, disk, libvirt).
ROOT_EQUIVALENT_GROUPS = ("sudo", "admin", "wheel", "docker", "lxd", "libvirt", "disk")
PROBE_UNDO = (
    "rm -f .intent/.custody-probe .claude-md-probe; "
    "if [ -e .intent-custody-probe ] && [ ! -e .intent ]; then "
    "mv .intent-custody-probe .intent; fi"
)


class Refused(Exception):
    """Nothing further is done."""


@dataclass(frozen=True)
class Layout:
    law_home: Path = Path("/opt/core-law")
    repo: Path = Path("/opt/dev/CORE")
    core_root: Path = Path("/opt/core")
    sudoers: Path = Path("/etc/sudoers.d/core-law")
    # The repository's parents are checked up to (not including) this one.
    ancestors_stop: Path = Path("/")

    @property
    def ancestors(self) -> list[Path]:
        found = []
        path = self.repo.parent
        while path != self.ancestors_stop and path != path.parent:
            found.append(path)
            path = path.parent
        return found

    @property
    def venv(self) -> Path:
        return self.law_home / "venv"

    @property
    def home(self) -> Path:
        return self.law_home / "home"

    @property
    def key(self) -> Path:
        return self.home / ".ssh" / "core_law_ledger"

    @property
    def build(self) -> Path:
        return self.law_home / "build"

    @property
    def law_root(self) -> Path:
        return self.core_root / "law"


# ---------------------------------------------------------------------------
# Host: accounts, ownership, processes and HTTP go through here, so the tests
# can run the whole procedure unprivileged against a temporary layout.
# ---------------------------------------------------------------------------


class Host:
    def is_root(self) -> bool:
        return os.geteuid() == 0

    def account(self, name: str) -> pwd.struct_passwd | None:
        try:
            return pwd.getpwnam(name)
        except KeyError:
            return None

    def run(
        self,
        cmd: list[str],
        *,
        user: str | None = None,
        cwd: Path | None = None,
        input: bytes | None = None,
        check: bool = True,
    ) -> subprocess.CompletedProcess[bytes]:
        argv = list(cmd)
        if user:
            home = pwd.getpwnam(user).pw_dir
            argv = [
                "runuser",
                "-u",
                user,
                "--",
                "env",
                "-i",
                f"HOME={home}",
                "PATH=/usr/local/bin:/usr/bin:/bin",
                "LANG=C.UTF-8",
                *cmd,
            ]
        result = subprocess.run(argv, cwd=cwd, input=input, capture_output=True)
        if check and result.returncode != 0:
            raise Refused(
                f"command failed ({result.returncode}): {' '.join(argv)}\n"
                + result.stderr.decode(errors="replace").strip()
            )
        return result

    def fetch(self, url: str, timeout: float = 30.0) -> bytes:
        request = urllib.request.Request(url, headers={"User-Agent": "core-law-setup"})
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.read()

    def owner(self, path: Path) -> tuple[str, str]:
        info = os.lstat(path)
        return pwd.getpwuid(info.st_uid).pw_name, grp.getgrgid(info.st_gid).gr_name

    def groups_of(self, user: str) -> list[str]:
        primary = pwd.getpwnam(user).pw_gid
        return sorted(
            g.gr_name for g in grp.getgrall() if user in g.gr_mem or g.gr_gid == primary
        )

    def chown(self, path: Path, user: str, group: str) -> None:
        os.lchown(path, pwd.getpwnam(user).pw_uid, grp.getgrnam(group).gr_gid)


# ---------------------------------------------------------------------------
# Pure helpers
# ---------------------------------------------------------------------------


def valid_version(version: str) -> bool:
    return bool(re.fullmatch(r"\d+\.\d+\.\d+", version))


def requirements_from_lock(lock_bytes: bytes) -> str:
    """Every locked package, pinned with all its file hashes (as core-deploy)."""
    lock = tomllib.loads(lock_bytes.decode())
    lines = []
    for package in lock.get("package", []):
        hashes = [f["hash"] for f in package.get("files", []) if f.get("hash")]
        if not hashes:
            raise Refused(f"poetry.lock has no hashes for {package['name']}")
        spec = f"{package['name']}=={package['version']}"
        if package.get("markers") and isinstance(package["markers"], str):
            spec += f" ; {package['markers']}"
        lines.append(spec + "".join(f" \\\n    --hash={h}" for h in hashes))
    return "\n".join(lines) + "\n"


def release_wheel(pypi_json: bytes, version: str) -> tuple[str, str]:
    """(filename, sha256) of the release's one py3 wheel on PyPI."""
    data = json.loads(pypi_json)
    if data.get("info", {}).get("version") != version:
        raise Refused(f"PyPI does not describe core-runtime {version}")
    wheels = [
        u
        for u in data.get("urls", [])
        if u.get("packagetype") == "bdist_wheel"
        and u.get("filename", "").endswith(".whl")
    ]
    if len(wheels) != 1:
        raise Refused(
            f"expected one wheel for core-runtime {version}, found {len(wheels)}"
        )
    return wheels[0]["filename"], wheels[0]["digests"]["sha256"]


def site_packages(venv: Path) -> Path:
    found = sorted(venv.glob("lib/python3*/site-packages"))
    if len(found) != 1:
        raise Refused(f"no single site-packages under {venv}")
    return found[0]


def installed_version(venv: Path) -> str | None:
    try:
        sp = site_packages(venv)
    except Refused:
        return None
    for meta in sp.glob("core_runtime-*.dist-info/METADATA"):
        for line in meta.read_text(errors="replace").splitlines():
            if line.startswith("Version: "):
                return line.split(": ", 1)[1].strip()
    return None


def venv_problems(venv: Path, version: str) -> list[str]:
    """Reasons the venv is not exactly the released code; empty when it is."""
    problems: list[str] = []
    try:
        sp = site_packages(venv)
    except Refused as exc:
        return [str(exc)]
    if installed_version(venv) != version:
        problems.append(
            f"core-runtime {installed_version(venv)} installed, not {version}"
        )
    for pth in sp.glob("*.pth"):
        if pth.name != "distutils-precedence.pth":
            problems.append(f"{pth.name}: a .pth file can load code from elsewhere")
    for direct in sp.glob("*.dist-info/direct_url.json"):
        problems.append(
            f"{direct.parent.name}: installed from a path or URL, not a release"
        )
    admin = venv / "bin" / "core-admin"
    if not admin.is_file():
        problems.append("bin/core-admin is missing")
    return problems


def sudoers_text(governor: str, venv: Path) -> str:
    return (
        "# ADR-170 D6: the governor's sudo password is the approval of a law proposal.\n"
        "# Installed by core-law-setup. sudo always asks for the password here.\n"
        f"Defaults>{CUSTODIAN} env_reset, always_set_home\n"
        "# A cached sudo login never approves: the password is asked every time.\n"
        f"Defaults>{CUSTODIAN} timestamp_timeout=0\n"
        f"{governor} ALL=({CUSTODIAN}) {venv}/bin/core-admin law apply *\n"
    )


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        digest.update(path.relative_to(root).as_posix().encode() + b"\0")
        digest.update(hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


# ---------------------------------------------------------------------------
# The procedure
# ---------------------------------------------------------------------------


@dataclass
class Setup:
    layout: Layout
    host: Host
    version: str
    governor: str
    apply: bool
    # Where pip finds wheels; empty means PyPI. Tests point it at a local folder.
    pip_source: tuple[str, ...] = ()
    log: list[str] = field(default_factory=list)
    failures: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)

    def say(self, message: str) -> None:
        self.log.append(message)
        print(message, flush=True)

    def act(self, message: str) -> bool:
        """Announce a change; True when it should be made."""
        self.say(("  do: " if self.apply else "  would: ") + message)
        return self.apply

    # -- preflight ---------------------------------------------------------

    def preflight(self) -> None:
        if not self.host.is_root():
            raise Refused("run it as root (sudo)")
        if not valid_version(self.version):
            raise Refused(f"not a release version: {self.version!r}")
        if self.governor in NOT_A_GOVERNOR or self.host.account(self.governor) is None:
            raise Refused(
                f"{self.governor!r} is not a human governor account "
                "(ADR-132 D10.9: not an assistant, service or system account)"
            )
        if not (self.layout.repo / ".intent").is_dir():
            raise Refused(f"no .intent/ in {self.layout.repo}")
        existing = self.host.account(CUSTODIAN)
        if existing is not None and existing.pw_shell not in (
            "/usr/sbin/nologin",
            "/sbin/nologin",
            "/bin/false",
        ):
            raise Refused(f"{CUSTODIAN} exists with a login shell; not ours")

    # -- 0. ownership plan ------------------------------------------------------

    def _now(self, path: Path) -> str:
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            return "absent"
        except PermissionError:
            return "unreadable (not root)"
        user, group = self.host.owner(path)
        return f"{user}:{group} {stat.S_IMODE(info.st_mode):o}"

    def ownership_plan(self) -> None:
        self.say("0. ownership and modes: now -> after")
        repo, law = self.layout.repo, self.layout.law_root
        rows: list[tuple[Path, str]] = [
            *[(p, "root:root 755") for p in reversed(self.layout.ancestors)],
            (repo, f"root:{DEV_GROUP} 3775 (sticky)"),
            (repo / ".intent", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (repo / ".specs", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (repo / "CLAUDE.md", f"{CUSTODIAN}:{CUSTODIAN} 644"),
            (repo / ".claude", f"{CUSTODIAN}:{DEV_GROUP} 3775 (sticky)"),
            (repo / ".claude" / "settings.json", f"{CUSTODIAN}:{CUSTODIAN} 644"),
            (repo / ".claude" / "hooks", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (self.layout.core_root, "root:root 755"),
            (law, "root:root 755"),
            (law / ".intent", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (law / ".specs", f"{CUSTODIAN}:{CUSTODIAN} 755, files 644"),
            (self.layout.law_home, "root:root 755"),
            (self.layout.venv, "root:root 755"),
            (self.layout.home, f"{CUSTODIAN}:{CUSTODIAN} 700"),
            (self.layout.key, f"{CUSTODIAN}:{CUSTODIAN} 600 (kept if present)"),
            (self.layout.sudoers, "root:root 440"),
        ]
        for path, target in rows:
            self.say(f"  {path!s:<45} {self._now(path):<26} -> {target}")

    # -- 5a. the repository's parents -----------------------------------------

    def ancestors(self) -> None:
        self.say("5a. the repository's parents: root-owned, not writable by others")
        for path in self.layout.ancestors:
            mode = stat.S_IMODE(path.stat().st_mode)
            owner = self.host.owner(path)[0]
            if owner == "root" and not mode & 0o022:
                continue
            # Whoever owns a parent can rename the repository away and put
            # another tree in its place; the sticky bit cannot stop that.
            if self.act(f"{path}: root:root 755 (was {self._now(path)})"):
                self.host.chown(path, "root", "root")
                os.chmod(path, 0o755)

    def bypass_report(self) -> None:
        self.say("5b. accounts that can bypass file permissions altogether")
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            groups = [
                g for g in self.host.groups_of(account) if g in ROOT_EQUIVALENT_GROUPS
            ]
            if not groups:
                self.say(f"  {account}: none")
                continue
            line = f"NOT PROTECTED from {account}: member of {', '.join(groups)}"
            if "sudo" in groups and set(groups) == {"sudo"}:
                line += " (root, but only with its password)"
            elif any(g != "sudo" for g in groups):
                line += " (root without any password)"
            self.warnings.append(line)
            self.say(f"  {line}")

    # -- 1. account ------------------------------------------------------------

    def account(self) -> None:
        self.say("1. account core-law")
        if self.host.account(CUSTODIAN) is not None:
            self.say("  ok: exists, no login shell")
            return
        if self.act("create system account core-law (no login, locked password)"):
            self.host.run(
                [
                    "useradd",
                    "--system",
                    "--user-group",
                    "--no-create-home",
                    "--home-dir",
                    str(self.layout.home),
                    "--shell",
                    "/usr/sbin/nologin",
                    CUSTODIAN,
                ]
            )
            self.host.run(["passwd", "--lock", CUSTODIAN])

    # -- 2. venv ---------------------------------------------------------------

    def directories(self) -> None:
        self.say("2a. /opt/core-law")
        for path, user, group, mode in (
            (self.layout.law_home, "root", "root", 0o755),
            (self.layout.build, "root", "root", 0o700),
            (self.layout.home, CUSTODIAN, CUSTODIAN, 0o700),
            (self.layout.home / ".ssh", CUSTODIAN, CUSTODIAN, 0o700),
            (self.layout.home / "scratch", CUSTODIAN, CUSTODIAN, 0o700),
        ):
            self._ensure_dir(path, user, group, mode)

    def _ensure_dir(self, path: Path, user: str, group: str, mode: int) -> None:
        if path.is_symlink():
            raise Refused(f"{path} is a symlink")
        exists = path.is_dir()
        right = (
            exists
            and self.host.owner(path) == (user, group)
            and (stat.S_IMODE(path.stat().st_mode) == mode)
        )
        if right:
            return
        if self.act(f"{path}: {user}:{group} {mode:o}"):
            path.mkdir(mode=mode, parents=True, exist_ok=True)
            self.host.chown(path, user, group)
            os.chmod(path, mode)

    def venv(self) -> None:
        self.say(f"2b. venv: core-runtime=={self.version}, released wheel only")
        venv = self.layout.venv
        if venv.is_dir() and not venv_problems(venv, self.version):
            self.say("  ok: installed and verified")
            return
        filename, wheel_sha = release_wheel(
            self.host.fetch(f"{PYPI}/{self.version}/json"), self.version
        )
        self.say(f"  release wheel {filename} sha256 {wheel_sha}")
        lock = self.host.fetch(f"{GITHUB_RAW}/v{self.version}/poetry.lock")
        requirements = requirements_from_lock(lock)
        if not self.act(
            f"install into {venv} itself (a venv records its own path), keeping the "
            "previous venv aside until the new one runs"
        ):
            return
        reqs = self.layout.build / "requirements.txt"
        reqs.write_text(requirements)
        pinned = self.layout.build / "core-runtime.txt"
        pinned.write_text(f"core-runtime=={self.version} --hash=sha256:{wheel_sha}\n")
        old = venv.with_name("venv.old")
        if venv.exists():
            if old.exists():
                shutil.rmtree(old)
            venv.rename(old)
        try:
            self.host.run(["/usr/bin/python3", "-I", "-m", "venv", str(venv)])
            pip = [
                str(venv / "bin" / "python"),
                "-I",
                "-m",
                "pip",
                "install",
                "--quiet",
                "--no-cache-dir",
                "--only-binary=:all:",
                "--require-hashes",
                "--no-deps",
                *self.pip_source,
            ]
            self.host.run([*pip, "-r", str(reqs)])
            self.host.run([*pip, "-r", str(pinned)])
            problems = venv_problems(venv, self.version)
            if problems:
                raise Refused(
                    "the new venv is not the released code:\n  " + "\n  ".join(problems)
                )
            # The installed entry point itself, as the account that will run it.
            self.host.run(
                [str(venv / "bin" / "core-admin"), "law", "--help"],
                user=CUSTODIAN,
                cwd=self.layout.repo,
            )
        except (Refused, OSError) as exc:
            if venv.exists():
                shutil.rmtree(venv)
            if old.exists():
                old.rename(venv)  # same path again, so its entry points work again
                raise Refused(f"{exc}\n  the previous venv was restored") from exc
            raise
        self.say("  installed; core-admin law --help ran as core-law")

    # -- 3. key ----------------------------------------------------------------

    def key(self) -> None:
        self.say("3. ledger signing key")
        key = self.layout.key
        if key.exists():
            self.say(f"  ok: {key} exists and is kept")
        elif self.act(f"generate {key} as core-law (ed25519)"):
            self.host.run(
                [
                    "ssh-keygen",
                    "-q",
                    "-t",
                    "ed25519",
                    "-N",
                    "",
                    "-C",
                    NAMESPACE,
                    "-f",
                    str(key),
                ],
                user=CUSTODIAN,
            )
        if not key.exists():
            return
        public = key.with_suffix(".pub")
        if not public.exists() and self.act(f"re-derive {public} from the private key"):
            derived = self.host.run(
                ["ssh-keygen", "-y", "-f", str(key)], user=CUSTODIAN
            )
            public.write_bytes(derived.stdout)
        for path, mode in ((key, 0o600), (public, 0o644)):
            if (
                path.exists()
                and (
                    self.host.owner(path) != (CUSTODIAN, CUSTODIAN)
                    or stat.S_IMODE(path.stat().st_mode) != mode
                )
                and self.act(f"{path}: {CUSTODIAN} {mode:o}")
            ):
                self.host.chown(path, CUSTODIAN, CUSTODIAN)
                os.chmod(path, mode)
        if public.exists():
            self.say(
                "  allowed_signers line for the first law proposal "
                "(.intent/custody/allowed_signers):\n"
                f'    {CUSTODIAN} namespaces="{NAMESPACE}" {public.read_text().strip()}'
            )

    # -- 4. governed text ------------------------------------------------------

    def governed_text(self) -> None:
        self.say("4. governed text owned by core-law (files 0644, directories 0755)")
        changes = 0
        for rel in GOVERNED:
            top = self.layout.repo / rel
            if not top.exists():
                continue
            for path in [top, *top.rglob("*")] if top.is_dir() else [top]:
                if path.is_symlink():
                    raise Refused(f"symlink in governed text: {path}")
                mode = 0o755 if path.is_dir() else 0o644
                if self.host.owner(path) != (CUSTODIAN, CUSTODIAN) or (
                    stat.S_IMODE(path.stat().st_mode) != mode
                ):
                    changes += 1
                    if self.apply:
                        self.host.chown(path, CUSTODIAN, CUSTODIAN)
                        os.chmod(path, mode)
        self.act(f"{changes} path(s) re-owned") if changes else self.say("  ok")

    # -- 5. names --------------------------------------------------------------

    def names(self) -> None:
        self.say("5. names: sticky repository root; .claude core-law:core-dev 3775")
        repo = self.layout.repo
        for path, user, group, mode in (
            (repo, "root", DEV_GROUP, 0o3775),
            (repo / ".claude", CUSTODIAN, DEV_GROUP, 0o3775),
        ):
            if (
                path.is_dir()
                and (
                    self.host.owner(path) != (user, group)
                    or stat.S_IMODE(path.stat().st_mode) != mode
                )
                and self.act(f"{path}: {user}:{group} {mode:o}")
            ):
                self.host.chown(path, user, group)
                os.chmod(path, mode)
        protected = {Path(n).parts[0] for n in PROTECTED_NAMES}
        handed = []
        for entry in sorted(repo.iterdir()):
            if (
                entry.name in protected
                or (
                    NOT_HANDED_OVER.match(entry.name)
                    and entry.name not in HANDED_OVER_ENV_FILES
                )
                or entry.is_symlink()
                or not entry.is_file()
            ):
                continue
            owner, group = self.host.owner(entry)
            if owner != ASSISTANT:
                handed.append(entry)
                if self.apply:
                    self.host.chown(entry, ASSISTANT, group)
        if handed:
            self.act(
                f"{len(handed)} root-level file(s) to {ASSISTANT}, so its git checkout can "
                "replace them under the sticky bit: "
                + ", ".join(e.name for e in handed)
            )

    # -- 6. the law beside the release ----------------------------------------

    def release_law(self) -> None:
        self.say(f"6. {self.layout.law_root} (ADR-132 D10.13)")
        for path in (self.layout.core_root, self.layout.law_root):
            self._ensure_dir(path, "root", "root", 0o755)
        for name in (".intent", ".specs"):
            source = self.layout.repo / name
            target = self.layout.law_root / name
            if target.exists():
                same = tree_digest(source) == tree_digest(target)
                self.say(
                    f"  {name}: kept; {'identical to' if same else 'DIFFERS from'} the dev tree"
                )
                if not same:
                    self.failures.append(
                        f"{target} differs from the development tree (consistency check)"
                    )
                continue
            if self.act(f"seed {target} from {source}, owned by core-law"):
                shutil.copytree(source, target, symlinks=False)
                for path in [target, *target.rglob("*")]:
                    self.host.chown(path, CUSTODIAN, CUSTODIAN)
                    os.chmod(path, 0o755 if path.is_dir() else 0o644)

    # -- 7. sudoers --------------------------------------------------------------

    def sudoers(self) -> None:
        self.say("7. sudoers: the governor's password approves (no NOPASSWD)")
        text = sudoers_text(self.governor, self.layout.venv)
        if "timestamp_timeout=0" not in text:
            raise Refused(
                "the core-law rule must ask for the password every time (ADR-170 D6)"
            )
        if any(
            "NOPASSWD" in line for line in text.splitlines() if not line.startswith("#")
        ):
            raise Refused("a password-less rule for core-law is forbidden (ADR-170 D6)")
        target = self.layout.sudoers
        if target.exists() and target.read_text() == text:
            self.say("  ok")
            return
        if self.act(f"install {target}: {self.governor} -> ({CUSTODIAN}) law apply"):
            staged = self.layout.build / "sudoers.core-law"
            staged.write_text(text)
            os.chmod(staged, 0o440)
            self.host.run(["visudo", "-c", "-f", str(staged)])
            shutil.copy2(staged, target)
            self.host.chown(target, "root", "root")
            os.chmod(target, 0o440)

    # -- 8. probes ---------------------------------------------------------------

    def probes(self) -> None:
        self.say("8. acceptance probes")
        if not self.apply:
            self.say("  would: run the probes after the changes")
            return
        repo = self.layout.repo
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            for label, script in PROBES:
                done = self.host.run(
                    ["sh", "-c", script], user=account, cwd=repo, check=False
                )
                # Undo whatever the probe managed, as root, whether or not it
                # "succeeded"; every undo is a no-op when nothing happened.
                self.host.run(["sh", "-c", PROBE_UNDO], cwd=repo, check=False)
                if done.returncode == 0:
                    self.failures.append(f"{account} could {label}")
                else:
                    self.say(f"  denied as expected: {account} {label}")
        moved = repo.with_name(repo.name + "-custody-probe")
        for account in PROBE_ACCOUNTS:
            if self.host.account(account) is None:
                continue
            done = self.host.run(
                ["mv", str(repo), str(moved)],
                user=account,
                cwd=repo.parent,
                check=False,
            )
            self.host.run(
                [
                    "sh",
                    "-c",
                    f'if [ -e "{moved}" ] && [ ! -e "{repo}" ]; then mv "{moved}" "{repo}"; fi',
                ],
                cwd=repo.parent,
                check=False,
            )
            if done.returncode == 0:
                self.failures.append(f"{account} could rename the repository")
            else:
                self.say(f"  denied as expected: {account} rename the repository")
        own = self.host.run(
            ["sh", "-c", "cp README.md .readme-probe && mv .readme-probe README.md"],
            user=ASSISTANT,
            cwd=repo,
            check=False,
        )
        if own.returncode != 0:
            self.failures.append(f"{ASSISTANT} cannot replace its own root-level file")
            self.host.run(["sh", "-c", "rm -f .readme-probe"], cwd=repo, check=False)
        else:
            self.say(f"  allowed as expected: {ASSISTANT} replaces README.md")

    def run_all(self) -> int:
        self.preflight()
        self.ownership_plan()
        self.account()
        self.directories()
        self.venv()
        self.key()
        self.governed_text()
        self.names()
        self.ancestors()
        self.bypass_report()
        self.release_law()
        self.sudoers()
        self.probes()
        if self.warnings:
            self.say(
                "The sticky bit and ownership do not hold against:\n  "
                + "\n  ".join(self.warnings)
            )
        if self.failures:
            self.say("FAILED:\n  " + "\n  ".join(self.failures))
            return 1
        if self.apply:
            self.say(
                "Stage 1 acceptance, by the governor (ADR-170 checks 3-9):\n"
                "  - warm cache: run `sudo -v`, then at once `sudo -u core-law "
                f"{self.layout.venv}/bin/core-admin law apply <id>`; it must ask for "
                "the password again\n"
                "  - the first law apply (--write) adds .intent/custody/allowed_signers "
                "with the line printed in step 3"
            )
        self.say(
            "done."
            if self.apply
            else "plan only; nothing changed. Re-run with --apply."
        )
        return 0


def main(
    argv: list[str] | None = None,
    host: Host | None = None,
    layout: Layout | None = None,
) -> int:
    parser = argparse.ArgumentParser(
        prog="core-law-setup", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument(
        "--version", required=True, help="core-runtime release, e.g. 2.14.0"
    )
    parser.add_argument("--governor", required=True, help="the human governor account")
    parser.add_argument("--repo", type=Path, default=Layout.repo)
    parser.add_argument("--apply", action="store_true", help="make the changes")
    args = parser.parse_args(argv)
    os.umask(0o022)
    setup = Setup(
        layout=layout or Layout(repo=args.repo),
        host=host or Host(),
        version=args.version,
        governor=args.governor,
        apply=args.apply,
    )
    try:
        return setup.run_all()
    except Refused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
