class Refused(Exception):
    """Nothing further is done."""


@dataclass(frozen=True)
class Layout:
    law_home: Path = Path("/opt/core-law")
    repo: Path = Path("/opt/dev/CORE")
    core_root: Path = Path("/opt/core")
    sudoers: Path = Path("/etc/sudoers.d/core-law")
    # Where the assistant kept the private-names check's configuration before
    # core-law took it over; read once, to seed.
    private_names_seed: Path = Path("/home/core-claude/.config/core/private-names.conf")
    system_units: Path = Path("/etc/systemd/system")
    # The repository's parents are checked up to (not including) this one.
    ancestors_stop: Path = Path("/")

    @property
    def ancestors(self) -> list[Path]:
        found = []
        path = self.repo.parent
        while path != self.ancestors_stop and path != path.parent:
            found.append(path)
            path = path.parent
        return found

    @property
    def venv(self) -> Path:
        return self.law_home / "venv"

    @property
    def home(self) -> Path:
        return self.law_home / "home"

    @property
    def key(self) -> Path:
        return self.home / ".ssh" / "core_law_ledger"

    @property
    def build(self) -> Path:
        return self.law_home / "build"

    @property
    def law_root(self) -> Path:
        return self.core_root / "law"

    @property
    def private_names(self) -> Path:
        return self.law_root / "private-names"

    @property
    def current(self) -> Path:
        return self.core_root / "current"

    @property
    def releases(self) -> Path:
        return self.core_root / "releases"


# ---------------------------------------------------------------------------
# Host: accounts, ownership and processes go through here, so the tests
# can run the whole procedure unprivileged against a temporary layout.
# ---------------------------------------------------------------------------


class Host:
    def is_root(self) -> bool:
        return os.geteuid() == 0

    def account(self, name: str) -> pwd.struct_passwd | None:
        try:
            return pwd.getpwnam(name)
        except KeyError:
            return None

    def run(
        self,
        cmd: list[str],
        *,
        user: str | None = None,
        cwd: Path | None = None,
        input: bytes | None = None,
        check: bool = True,
    ) -> subprocess.CompletedProcess[bytes]:
        argv = list(cmd)
        if user:
            home = pwd.getpwnam(user).pw_dir
            argv = [
                "runuser",
                "-u",
                user,
                "--",
                "env",
                "-i",
                f"HOME={home}",
                "PATH=/usr/local/bin:/usr/bin:/bin",
                "LANG=C.UTF-8",
                *cmd,
            ]
        # No terminal: a command must never wait on a prompt (mv asks before
        # replacing a file it cannot write when stdin is a terminal).
        result = subprocess.run(
            argv,
            cwd=cwd,
            input=input,
            stdin=None if input is not None else subprocess.DEVNULL,
            capture_output=True,
        )
        if check and result.returncode != 0:
            raise Refused(
                f"command failed ({result.returncode}): {' '.join(argv)}\n"
                + result.stderr.decode(errors="replace").strip()
            )
        return result

    def owner(self, path: Path) -> tuple[str, str]:
        info = os.lstat(path)
        return pwd.getpwuid(info.st_uid).pw_name, grp.getgrgid(info.st_gid).gr_name

    def groups_of(self, user: str) -> list[str]:
        primary = pwd.getpwnam(user).pw_gid
        return sorted(
            g.gr_name for g in grp.getgrall() if user in g.gr_mem or g.gr_gid == primary
        )

    def chown(self, path: Path, user: str, group: str) -> None:
        os.lchown(path, pwd.getpwnam(user).pw_uid, grp.getgrnam(group).gr_gid)


