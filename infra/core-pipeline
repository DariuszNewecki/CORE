#!/usr/bin/python3 -I
# infra/core-pipeline — installed as /usr/local/sbin/core-pipeline (root:root 0755); run by
# core-pipeline.timer as core-runner (one-path flow, governor ruling 2026-10-12).
"""
core-pipeline — after the governor's change lands on main, make it live.

The governor's one action for a change is approving a pull request's last
commit, or merging it, on GitHub. This runner, on a timer, as the account
``core-runner``:

 1. reads main's head from GitHub; nothing new -> it only refreshes status;
 2. acts only on a commit the governor's GitHub account (``GOVERNOR_GITHUB``)
    merged, or whose pull request someone else merged (auto-merge) after the
    governor's account approved its exact last commit (governor ruling
    2026-10-13: the approval is the decision; a new commit dismisses it).
    An approval by any other account never counts. Anything else is skipped
    and logged;
 3. waits until every CI check run has completed: on the pull-request head
    when the merge has its exact tree, else on the merge commit itself (CI
    runs on pushes to main); a red result is reported once and skipped;
 4. runs ``sudo -n core-deploy <sha> --migrate --merged-by <login>``.
    core-deploy builds, applies the merged law through core-law (the merge is
    the approval), migrates only when something is pending, switches,
    verifies, and switches back itself when the new release fails;
 5. after a deploy, runs the sandbox check as core; when it fails, rolls back
    (``sudo -n core-deploy --rollback``) and opens an issue;
 6. writes ``status.json`` for ``core-admin runtime status``.

GitHub's API allows 60 calls an hour without a token (#1065). A tick that
finds nothing new costs none; a merge's facts are read once and kept in the
state file; a head no pull request explains is looked at again only while
GitHub may still be settling (``SETTLE``). When the limit runs out anyway,
the runner waits for its reset and says so in ``status.json``
(``state: rate limited``, ``until``) instead of failing every tick.

Privileges (sudoers from one-path-setup.sh): core-runner may run exactly
``/usr/local/sbin/core-deploy`` as root and ``/usr/local/sbin/core-sandbox-check``
as core, without a password and without a shell. It holds no database
credential and cannot write the law or the runtime itself.

Configuration (/etc/core/pipeline.conf, KEY=VALUE): GITHUB_REPO (owner/name),
GOVERNOR_GITHUB (the governor's GitHub login), BRANCH (main), TOKEN_FILE (a
GitHub token that may open issues; optional).
"""

from __future__ import annotations

import argparse
import datetime
import fcntl
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path


GREEN = {"success", "skipped", "neutral"}
CORE_DEPLOY = "/usr/local/sbin/core-deploy"
SANDBOX_CHECK = "/usr/local/sbin/core-sandbox-check"
EX_DEPLOY_GOVERNOR = 3
# How long a head whose merger GitHub has not reported is looked at again.
SETTLE = datetime.timedelta(minutes=15)


@dataclass(frozen=True)
class Layout:
    state_dir: Path = Path("/var/lib/core-pipeline")
    conf: Path = Path("/etc/core/pipeline.conf")
    current: Path = Path("/opt/core/current")

    @property
    def state(self) -> Path:
        return self.state_dir / "state.json"

    @property
    def status(self) -> Path:
        return self.state_dir / "status.json"

    @property
    def logs(self) -> Path:
        return self.state_dir / "logs"

    @property
    def lock(self) -> Path:
        return self.state_dir / "lock"


class Host:
    """Every side effect outside the state directory goes through here."""

    def __init__(self, token: str | None = None) -> None:
        self.token = token

    def run(self, cmd: list[str]) -> subprocess.CompletedProcess[bytes]:
        return subprocess.run(cmd, capture_output=True, stdin=subprocess.DEVNULL)

    def http(self, url: str, payload: dict | None = None) -> object:
        headers = {
            "Accept": "application/vnd.github+json",
            "User-Agent": "core-pipeline",
        }
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        data = None
        if payload is not None:
            data = json.dumps(payload).encode()
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=data, headers=headers)
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode())

    def now(self) -> datetime.datetime:
        return datetime.datetime.now(datetime.UTC)


def latest_runs(runs: list[dict]) -> list[dict]:
    """The newest run of each check: a re-run supersedes the run before it.

    GitHub keeps every run of a check on a commit (a PR description edit
    re-runs host-change-stated), and run ids increase. A check is its name
    within one app; runs without a name or an id are each kept.
    """
    latest: dict[object, dict] = {}
    for i, run in enumerate(runs):
        name, run_id = run.get("name"), run.get("id")
        app = (run.get("app") or {}).get("id")
        key: object = (app, name)
        if name is None or not isinstance(run_id, int):
            key = ("unnamed", i)
        if key not in latest or run_id > latest[key]["id"]:
            latest[key] = run
    return list(latest.values())


def rate_limit_reset(
    exc: urllib.error.HTTPError, now: datetime.datetime
) -> datetime.datetime | None:
    """When GitHub will answer again, if *exc* is its rate limit; else None.

    A 403 that is not a rate limit (no permission) stays an error."""
    if exc.code not in (403, 429):
        return None
    headers = exc.headers or {}
    retry_after = headers.get("Retry-After")
    if retry_after and retry_after.isdigit():
        return now + datetime.timedelta(seconds=int(retry_after))
    reset = headers.get("X-RateLimit-Reset")
    if headers.get("X-RateLimit-Remaining") == "0" and reset and reset.isdigit():
        return datetime.datetime.fromtimestamp(int(reset), datetime.UTC)
    if exc.code == 429:
        return now + datetime.timedelta(minutes=1)
    return None


def read_conf(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for line in path.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip().strip('"')
    return values


@dataclass
class Runner:
    host: Host
    layout: Layout
    repo: str
    governor: str
    branch: str = "main"
    api: str = "https://api.github.com"
    state: dict = field(default_factory=dict)

    # -- state ---------------------------------------------------------------

    def load(self) -> None:
        if self.layout.state.is_file():
            self.state = json.loads(self.layout.state.read_text())

    def save(self) -> None:
        self.layout.state.write_text(json.dumps(self.state, indent=2, sort_keys=True))

    def live_sha(self) -> str | None:
        if not self.layout.current.is_symlink():
            return None
        return Path(os.readlink(self.layout.current)).name

    def write_status(self, **fields: object) -> None:
        status = {
            "branch": self.branch,
            "main_head": self.state.get("seen_head"),
            "live": self.live_sha(),
            "last": self.state.get("last"),
            "at": self.host.now().isoformat(),
            **fields,
        }
        self.layout.status.write_text(json.dumps(status, indent=2, sort_keys=True))
        os.chmod(self.layout.status, 0o644)

    # -- GitHub --------------------------------------------------------------

    def head(self) -> str:
        """The branch head. Read with git ls-remote, which is not rate limited:
        this runs every tick, and the unauthenticated API allows only 60 calls
        an hour (2026-10-13: a day of merges ran out and stalled the deploy).
        The API is the fallback when git cannot answer."""
        done = self.host.run(
            [
                "git",
                "ls-remote",
                "--heads",
                f"https://github.com/{self.repo}.git",
                f"refs/heads/{self.branch}",
            ]
        )
        words = done.stdout.decode(errors="replace").split()
        if done.returncode == 0 and words and len(words[0]) == 40:
            return words[0]
        data = self.host.http(f"{self.api}/repos/{self.repo}/branches/{self.branch}")
        assert isinstance(data, dict)
        return str(data["commit"]["sha"])

    def ci(self, sha: str) -> str:
        """'green', 'red' or 'pending'."""
        data = self.host.http(
            f"{self.api}/repos/{self.repo}/commits/{sha}/check-runs?per_page=100"
        )
        runs = latest_runs(data.get("check_runs", []) if isinstance(data, dict) else [])
        if not runs or any(r.get("status") != "completed" for r in runs):
            return "pending"
        if any(r.get("conclusion") not in GREEN for r in runs):
            return "red"
        return "green"

    def tree(self, sha: str) -> str | None:
        data = self.host.http(f"{self.api}/repos/{self.repo}/git/commits/{sha}")
        return str(data["tree"]["sha"]) if isinstance(data, dict) else None

    def merge(self, sha: str) -> tuple[str | None, str | None]:
        """(merger login, tested head sha) of the pull request merged as *sha*."""
        pulls = self.host.http(f"{self.api}/repos/{self.repo}/commits/{sha}/pulls")
        if not isinstance(pulls, list):
            return None, None
        for pull in pulls:
            if pull.get("merge_commit_sha") != sha:
                continue
            # The per-commit list leaves merged_by empty; only the pull
            # request itself carries it.
            detail = self.host.http(
                f"{self.api}/repos/{self.repo}/pulls/{pull['number']}"
            )
            if not isinstance(detail, dict) or not detail.get("merged_by"):
                return None, None
            head = (detail.get("head") or {}).get("sha")
            merger = str(detail["merged_by"]["login"])
            if merger != self.governor and head and self.approved(pull["number"], head):
                self.log(
                    sha, f"merged by {merger} on {self.governor}'s approval of {head}"
                )
                merger = self.governor
            return merger, str(head) if head else None
        return None, None

    def approved(self, number: int, head: str) -> bool:
        """True when the governor's account approved *head*, the pull
        request's exact last commit, and did not ask for changes after."""
        reviews = self.host.http(
            f"{self.api}/repos/{self.repo}/pulls/{number}/reviews?per_page=100"
        )
        if not isinstance(reviews, list):
            return False
        verdict = None
        for review in reviews:  # chronological
            if (review.get("user") or {}).get("login") != self.governor:
                continue
            if review.get("state") in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
                verdict = (review.get("state"), review.get("commit_id"))
        return verdict == ("APPROVED", head)

    def issue(self, title: str, body: str) -> str | None:
        if not self.host.token:
            return None
        try:
            data = self.host.http(
                f"{self.api}/repos/{self.repo}/issues",
                {"title": title, "body": body[-60000:]},
            )
            return str(data.get("html_url")) if isinstance(data, dict) else None
        except Exception:
            return None

    # -- the step --------------------------------------------------------------

    def log(self, sha: str, text: str) -> None:
        self.layout.logs.mkdir(parents=True, exist_ok=True)
        with (self.layout.logs / f"{sha[:12]}.log").open("a") as handle:
            handle.write(f"[{self.host.now().isoformat()}] {text}\n")

    def run_logged(self, sha: str, cmd: list[str]) -> tuple[int, str]:
        done = self.host.run(cmd)
        text = (done.stdout + done.stderr).decode(errors="replace")
        self.log(sha, f"$ {' '.join(cmd)}\n{text}\n(exit {done.returncode})")
        return done.returncode, text

    def fail(self, sha: str, what: str, text: str) -> None:
        url = self.issue(
            f"core-pipeline: {what} ({sha[:12]})",
            f"main at `{sha}` did not go live: {what}.\n\n```\n{text[-20000:]}\n```",
        )
        self.state["last"] = {
            "sha": sha,
            "result": "failed",
            "what": what,
            "issue": url,
        }

    def lookup(self, head: str) -> tuple[str | None, str | None]:
        """``merge(head)``, read from GitHub once: a merge's merger and tested
        head never change. An empty answer is not kept (GitHub may still be
        settling)."""
        cached = self.state.get("lookup") or {}
        if cached.get("sha") == head:
            return cached["merger"], cached["tested"]
        merger, tested = self.merge(head)
        if merger is not None:
            self.state["lookup"] = {"sha": head, "merger": merger, "tested": tested}
        return merger, tested

    def settling(self, head: str) -> bool:
        """True while *head*, first seen less than ``SETTLE`` ago, may still
        get its merger from GitHub."""
        first = self.state.get("first_seen")
        if not first or first[0] != head:
            self.state["first_seen"] = [head, self.host.now().isoformat()]
            return True
        return self.host.now() - datetime.datetime.fromisoformat(first[1]) < SETTLE

    def tick(self) -> None:
        self.load()
        until = self.state.get("rate_limited_until")
        if until and self.host.now() < datetime.datetime.fromisoformat(until):
            self.write_status(state="rate limited", until=until)
            return
        self.state.pop("rate_limited_until", None)
        try:
            self.step()
        except urllib.error.HTTPError as exc:
            reset = rate_limit_reset(exc, self.host.now())
            if reset is None:
                raise
            self.state["rate_limited_until"] = reset.isoformat()
            self.save()
            self.write_status(
                state="rate limited", until=reset.isoformat(), error=str(exc)[:500]
            )

    def step(self) -> None:
        head = self.head()
        self.state["seen_head"] = head
        # A skipped head is looked at again while its merger is unknown and
        # GitHub may still be settling, so a merge read too early is not lost.
        # A known merger is final: looking again would only spend API calls.
        skipped = (self.state.get("last") or {}).get("result") == "skipped"
        settled = (self.state.get("lookup") or {}).get("sha") == head
        finished = head == self.state.get("done") and (
            not skipped or settled or not self.settling(head)
        )
        if finished or head == self.live_sha():
            self.state["done"] = head
            self.save()
            self.write_status(state="idle")
            return
        self.settling(head)
        merger, tested = self.lookup(head)
        if merger != self.governor or not tested:
            note = f"skipped: merged by {merger!r}, not {self.governor!r}"
            if self.state.get("skip_note") != [head, note]:
                self.log(head, note)
                self.state["skip_note"] = [head, note]
            self.state["done"] = head
            self.state["last"] = {
                "sha": head,
                "result": "skipped",
                "what": f"not merged by {self.governor} (merger: {merger})",
            }
            self.save()
            self.write_status(state="idle")
            return
        # When the merge has the pull-request head's exact tree, CI's run on
        # the PR covers it (core-deploy re-checks: --tested-as). Otherwise the
        # PR was behind main, and CI's own run on the merge commit (CI runs on
        # pushes to main) is the one that counts.
        cached = self.state["lookup"]
        if "same_tree" not in cached:
            cached["same_tree"] = self.tree(head) == self.tree(tested)
        same_tree = bool(cached["same_tree"])
        ci_sha = tested if same_tree else head
        ci = self.ci(ci_sha)
        if ci == "pending":
            self.save()
            self.write_status(state="waiting for CI", waiting_on=head)
            return
        self.state["done"] = head
        if ci == "red":
            self.fail(
                head, "CI is red on main", "see the commit's check runs on GitHub"
            )
            self.save()
            self.write_status(state="idle")
            return

        self.write_status(state="deploying", deploying=head, merged_by=merger)
        rc, text = self.run_logged(
            head,
            [
                "sudo",
                "-n",
                CORE_DEPLOY,
                head,
                "--migrate",
                "--merged-by",
                merger,
                *(["--tested-as", tested] if same_tree else []),
            ],
        )
        if rc == EX_DEPLOY_GOVERNOR:
            self.fail(head, "deploy stopped after a migration; your decision", text)
        elif rc != 0:
            self.fail(head, "deploy refused or switched back", text)
        else:
            check_rc, check_text = self.run_logged(
                head, ["sudo", "-n", "-u", "core", SANDBOX_CHECK]
            )
            if check_rc != 0:
                back_rc, back_text = self.run_logged(
                    head, ["sudo", "-n", CORE_DEPLOY, "--rollback"]
                )
                self.fail(
                    head,
                    "probes failed after deploy; "
                    + ("rolled back" if back_rc == 0 else "ROLLBACK FAILED"),
                    check_text + "\n" + back_text,
                )
            else:
                self.state["last"] = {
                    "sha": head,
                    "result": "live",
                    "merged_by": merger,
                }
        self.save()
        self.write_status(state="idle")


def main(
    argv: list[str] | None = None,
    host: Host | None = None,
    layout: Layout | None = None,
) -> int:
    parser = argparse.ArgumentParser(
        prog="core-pipeline", description=__doc__.split("\n\n")[0]
    )
    parser.parse_args(argv)
    layout = layout or Layout()
    conf = read_conf(layout.conf)
    repo, governor = conf.get("GITHUB_REPO"), conf.get("GOVERNOR_GITHUB")
    if not repo or not governor:
        print(
            f"core-pipeline: GITHUB_REPO and GOVERNOR_GITHUB are required in {layout.conf}",
            file=sys.stderr,
        )
        return 1
    if host is None:
        token_file = Path(conf.get("TOKEN_FILE", "/etc/core/pipeline-github-token"))
        token = token_file.read_text().strip() if token_file.is_file() else None
        host = Host(token or None)
    layout.state_dir.mkdir(parents=True, exist_ok=True)
    runner = Runner(host, layout, repo, governor, branch=conf.get("BRANCH", "main"))
    with layout.lock.open("a") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            runner.tick()
        except Exception as exc:  # network, GitHub, a bad state file
            runner.write_status(state="error", error=str(exc)[:500])
            print(f"core-pipeline: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
