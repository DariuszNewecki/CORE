@dataclass
class Deployer:
    host: Host
    layout: Layout
    options: Options = field(default_factory=Options)
    # The pre-migration dump's restore check, for the ledger (#1113).
    backup_check: dict[str, object] | None = None

    # -- small wrappers -----------------------------------------------------

    def say(self, message: str) -> None:
        print(f"core-deploy: {message}", flush=True)

    def git(self, *args: str, input: bytes | None = None) -> bytes:
        return self.host.run(
            ["git", "-C", str(self.layout.repo), *SAFE_GIT, *args],
            user=SERVICE_USER,
            input=input,
        ).stdout

    def systemctl(
        self, *args: str, check: bool = True
    ) -> subprocess.CompletedProcess[bytes]:
        return self.host.run(
            ["systemctl", "--user", "-M", f"{SERVICE_USER}@", *args], check=check
        )

    def as_service(
        self, cmd: list[str], *, unit: str | None = None, wait: bool = True
    ) -> subprocess.CompletedProcess[bytes]:
        """Run in core's user manager with the units' own environment."""
        argv = [
            "systemd-run",
            "--user",
            "-M",
            f"{SERVICE_USER}@",
            "--collect",
            "--quiet",
            f"--property=EnvironmentFile={self.layout.core_env}",
            f"--property=WorkingDirectory={self.layout.run}",
        ]
        if unit:
            argv.append(f"--unit={unit}")
        if wait:
            argv += ["--wait", "--pipe"]
        return self.host.run([*argv, "--", *cmd], check=False)

    def units(self) -> list[str]:
        out = self.systemctl(
            "list-units", "--all", "--plain", "--no-legend", "--type=service", "core-*"
        ).stdout.decode()
        names = {line.split()[0] for line in out.splitlines() if line.strip()}
        if not names:
            # Nothing loaded (a first deploy, or every service down): restart
            # starts them, so take the enabled ones default.target wants.
            wants = self.systemctl(
                "show", "default.target", "--property=Wants", "--value", check=False
            ).stdout.decode()
            names = {
                n
                for n in wants.split()
                if n.startswith("core-") and n.endswith(".service")
            }
        return [n for n in sorted(names) if not n.startswith(READINESS_UNIT)]

    def declared_units(self, sha: str) -> list[str]:
        """The units release *sha* says CORE runs (``daemon units``); empty
        for a release older than that command."""
        result = self.as_service(
            [self.release_python(sha), "-I", "-m", "cli.admin_cli", "daemon", "units"]
        )
        if result.returncode != 0:
            return []
        return [
            u
            for u in result.stdout.decode(errors="replace").split()
            if u.startswith("core-") and u.endswith(".service")
        ]

    def with_declared(self, units: list[str], sha: str) -> list[str]:
        """Loaded units plus those *sha* declares: after a reboot nothing
        was enabled, so only what someone started by hand was loaded and the
        dedicated workers stayed down (2026-10-14)."""
        names = set(units) | set(self.declared_units(sha))
        return [n for n in sorted(names) if not n.startswith(READINESS_UNIT)]

    def enable(self, units: list[str]) -> None:
        """Enable the verified units so core's user manager (lingering)
        starts them at boot. A failure is reported, not a refusal: the
        release is already live."""
        done = self.systemctl("enable", *units, check=False)
        if done.returncode != 0:
            self.say(f"warning: could not enable units for boot (rc {done.returncode})")

    def current_sha(self) -> str | None:
        if not self.layout.current.is_symlink():
            return None
        return Path(os.readlink(self.layout.current)).name

    def switch_current(self, sha: str) -> None:
        tmp = self.layout.root / ".current.tmp"
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        tmp.symlink_to(Path("releases") / sha)
        os.replace(tmp, self.layout.current)

    def ledger(self, entry: dict[str, object]) -> None:
        with self.layout.ledger.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, sort_keys=True) + "\n")

    def ledger_entries(self) -> list[dict[str, object]]:
        if not self.layout.ledger.is_file():
            return []
        return [
            json.loads(line)
            for line in self.layout.ledger.read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]

    # -- step 1 ---------------------------------------------------------------

    def branch(self) -> str:
        return read_env_file(self.layout.deploy_conf).get("DEPLOY_BRANCH") or "develop"

    def resolve(self, ref: str, upstream: str) -> str:
        if not valid_ref(ref):
            raise Refused(f"not a valid tag or sha: {ref!r}")
        branch = self.branch()
        upstream_ref = f"refs/remotes/upstream/{branch}"
        self.git("fetch", "--no-tags", upstream, f"refs/heads/{branch}:{upstream_ref}")
        if not re.fullmatch(r"[0-9a-f]{40}", ref):
            self.git("fetch", "--no-tags", upstream, f"refs/tags/{ref}:refs/tags/{ref}")
        sha = self.git("rev-parse", "--verify", f"{ref}^{{commit}}").decode().strip()
        on_develop = self.host.run(
            [
                "git",
                "-C",
                str(self.layout.repo),
                *SAFE_GIT,
                "merge-base",
                "--is-ancestor",
                sha,
                upstream_ref,
            ],
            user=SERVICE_USER,
            check=False,
        )
        if on_develop.returncode != 0:
            raise Refused(f"{sha[:12]} is not on upstream {branch}")
        slug = github_slug(upstream)
        self.require_green_ci(slug, sha, branch)
        self.require_promotion(slug, sha)
        return sha

    def conf(self, key: str) -> str | None:
        """*key* from deploy.conf, else from core-pipeline's pipeline.conf
        (one place names the governor for both)."""
        for path in (self.layout.deploy_conf, self.options.pipeline_conf):
            try:
                value = read_env_file(path).get(key)
            except OSError:
                value = None
            if value:
                return value
        return None

    def require_promotion(self, slug: str, sha: str) -> None:
        """Refuse unless *sha* is the head of the promotion the governor
        approved (ADR-171): the deploy needs no other approval and accepts
        none."""
        number = self.options.promotion
        if number is None:
            raise Refused(
                "a deploy needs --promotion <PR>: the promotion into live the "
                "governor approved (ADR-171)"
            )
        governor = self.conf("GOVERNOR_GITHUB")
        if not governor:
            raise Refused(
                f"GOVERNOR_GITHUB missing from {self.layout.deploy_conf} and "
                f"{self.options.pipeline_conf}"
            )
        live = self.conf("LIVE_BRANCH") or "live"
        api = f"{self.options.github_api}/repos/{slug}/pulls/{number}"
        try:
            pull = self.host.http_json(api)
            reviews = self.host.http_json(f"{api}/reviews?per_page=100")
        except Exception as exc:  # network, rate limit, parse
            raise Refused(f"promotion #{number} unavailable: {exc}") from exc
        if not isinstance(pull, dict) or not isinstance(reviews, list):
            raise Refused(f"promotion #{number}: unexpected answer from GitHub")
        head = pull.get("head") or {}
        problems = []
        # Open while it waits for its deploy; merged once live moved to it
        # (a rebuild redeploys it). Closed without a merge is a rejection.
        if pull.get("state") != "open" and not pull.get("merged"):
            problems.append("it was closed without being merged")
        if (pull.get("base") or {}).get("ref") != live:
            problems.append(f"it does not go into {live}")
        if not str(head.get("ref") or "").startswith("promote/"):
            problems.append("its branch is not promote/...")
        if head.get("sha") != sha:
            problems.append(f"its head is {str(head.get('sha'))[:12]}, not {sha[:12]}")
        verdict = None
        for review in reviews:  # chronological
            if (review.get("user") or {}).get("login") != governor:
                continue
            if review.get("state") in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
                verdict = (review.get("state"), review.get("commit_id"))
        if verdict != ("APPROVED", sha):
            problems.append(f"{governor} has not approved {sha[:12]}")
        if problems:
            raise Refused(f"promotion #{number}: " + "; ".join(problems))

    def require_green_ci(self, slug: str, sha: str, branch: str) -> None:
        """Refuse unless every check GitHub's rules for *branch* require has a
        green newest run on *sha*, and no other check run is red or running.
        A required check that never ran is refused, not taken as green (F5);
        rules that cannot be read or require nothing refuse too."""
        api = f"{self.options.github_api}/repos/{slug}"
        try:
            data = self.host.http_json(f"{api}/commits/{sha}/check-runs?per_page=100")
            rules = self.host.http_json(f"{api}/rules/branches/{branch}?per_page=100")
        except Exception as exc:  # network, rate limit, parse
            raise Refused(f"CI state for {sha[:12]} unavailable: {exc}") from exc
        runs = latest_runs(data.get("check_runs", []) if isinstance(data, dict) else [])
        required = required_checks(rules)
        if not required:
            raise Refused(f"GitHub's rules for {branch} require no check")
        bad = unmet_required(runs, required) + [
            f"{r.get('name')}: {r.get('status')}/{r.get('conclusion')}"
            for r in runs
            if r.get("status") != "completed" or r.get("conclusion") not in GREEN
        ]
        bad = list(dict.fromkeys(bad))  # a red required check is named once
        if bad:
            raise Refused(f"CI for {sha[:12]} is not green: " + "; ".join(bad))

    # -- step 3 ---------------------------------------------------------------

    def build_and_install(self, sha: str) -> str:
        build = self.layout.build / sha
        if build.exists():
            shutil.rmtree(build)
        (build / "src").mkdir(parents=True)
        (build / "wheel").mkdir()
        (build / "wheelhouse").mkdir()

        archive = self.git("archive", "--format=tar", sha)
        lock = self.git("show", f"{sha}:poetry.lock")
        pyproject = self.git("show", f"{sha}:pyproject.toml")
        requirements = build / "requirements.txt"
        requirements.write_text(requirements_from_lock(lock), encoding="utf-8")
        core_cli = build / "core-cli.txt"
        core_cli.write_text(
            f"{CORE_CLI} --hash=sha256:{CORE_CLI_SHA256}\n", encoding="utf-8"
        )
        self.host.chown(build, BUILD_USER, recursive=True)

        self.say("building as core-build")
        self.host.run(
            ["tar", "-x", "-C", str(build / "src")], user=BUILD_USER, input=archive
        )
        self.host.run(
            ["/usr/bin/python3", "-I", "-m", "venv", str(build / "tools")],
            user=BUILD_USER,
        )
        pip = str(build / "tools" / "bin" / "pip")
        self.host.run(
            [
                pip,
                "wheel",
                "--no-cache-dir",
                "--no-deps",
                "--wheel-dir",
                str(build / "wheel"),
                str(build / "src"),
            ],
            user=BUILD_USER,
        )
        self.host.run(
            [
                pip,
                "download",
                "--no-cache-dir",
                "--only-binary=:all:",
                "--require-hashes",
                "-r",
                str(requirements),
                "-d",
                str(build / "wheelhouse"),
            ],
            user=BUILD_USER,
        )
        self.host.run(
            [
                pip,
                "download",
                "--no-cache-dir",
                "--only-binary=:all:",
                "--no-deps",
                "--require-hashes",
                "-r",
                str(core_cli),
                "-d",
                str(build / "core-cli"),
            ],
            user=BUILD_USER,
        )
        wheels = sorted((build / "wheel").glob("*.whl"))
        if len(wheels) != 1:
            raise Refused(f"expected one built wheel, found {[w.name for w in wheels]}")
        verify_wheel(wheels[0], archive, pyproject)
        wheel_sha = sha256_file(wheels[0])

        self.say("installing as root (wheels only)")
        release = self.layout.releases / sha
        venv = release / "venv"
        try:
            self.host.run(["/usr/bin/python3", "-I", "-m", "venv", str(venv)])
            python = str(venv / "bin" / "python")
            self.host.run(
                [
                    python,
                    "-I",
                    "-m",
                    "pip",
                    "install",
                    "--no-cache-dir",
                    "--no-index",
                    "--only-binary=:all:",
                    "--require-hashes",
                    "--find-links",
                    str(build / "wheelhouse"),
                    "-r",
                    str(requirements),
                ]
            )
            self.host.run(
                [
                    python,
                    "-I",
                    "-m",
                    "pip",
                    "install",
                    "--no-cache-dir",
                    "--no-index",
                    "--no-deps",
                    str(wheels[0]),
                ]
            )
            self.host.run(
                [
                    python,
                    "-I",
                    "-m",
                    "pip",
                    "install",
                    "--no-cache-dir",
                    "--no-index",
                    "--only-binary=:all:",
                    "--no-deps",
                    "--require-hashes",
                    "--find-links",
                    str(build / "core-cli"),
                    "-r",
                    str(core_cli),
                ]
            )
            (venv / "core-release.json").write_text(
                json.dumps({"sha": sha, "wheel_sha256": wheel_sha}) + "\n",
                encoding="utf-8",
            )
            # core-law-setup installs exactly this wheel (the hash above) and
            # pins its dependencies from this lock (read through core's git).
            dist = release / "dist"
            dist.mkdir()
            shutil.copyfile(wheels[0], dist / wheels[0].name)
            (dist / "poetry.lock").write_bytes(lock)
            self.host.run(["chown", "-R", "root:root", str(release)])
            self.host.run(["chmod", "-R", "go-w", str(release)])
        except BaseException:
            shutil.rmtree(release, ignore_errors=True)
            raise
        shutil.rmtree(build, ignore_errors=True)
        return wheel_sha

    def release_python(self, sha: str) -> str:
        return str(self.layout.releases / sha / "venv" / "bin" / "python")

    # -- steps 4-5 ------------------------------------------------------------

    def database_status(self, sha: str) -> dict[str, object]:
        result = self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "cli.admin_cli",
                "database",
                "status",
                "--format",
                "json",
            ]
        )
        try:
            status = json.loads(result.stdout.decode())
        except ValueError as exc:
            raise Refused(
                f"database status unreadable (rc {result.returncode})"
            ) from exc
        if not status.get("connected"):
            raise Refused(f"database not reachable: {status.get('error')}")
        if status.get("probe_failures"):
            raise Refused(f"schema probe failures: {status['probe_failures']}")
        return status

    def migrate(self, sha: str, units: list[str]) -> tuple[list[str], str]:
        status = self.database_status(sha)
        raw = status.get("pending_migrations")
        pending = [str(p) for p in raw] if isinstance(raw, list) else []
        if not pending:
            return [], ""
        if not self.options.migrate:
            raise Refused(
                "pending migrations (re-run with --migrate): " + ", ".join(pending)
            )
        backup_cmd = read_env_file(self.layout.deploy_conf).get("BACKUP_COMMAND")
        if not backup_cmd or "{out}" not in backup_cmd:
            raise Refused(
                "--migrate needs BACKUP_COMMAND (with {out}) in "
                + str(self.layout.deploy_conf)
            )

        self.say("stopping every unit for the migration")
        self.systemctl("stop", *units)
        stamp = self.host.now().strftime("%Y%m%dT%H%M%SZ")
        backup = self.layout.backups / f"{stamp}-pre-{sha[:12]}.dump"
        self.layout.backups.mkdir(parents=True, exist_ok=True)
        done = self.host.run(
            ["/bin/sh", "-c", backup_cmd.replace("{out}", str(backup))], check=False
        )
        if done.returncode != 0 or not backup.is_file() or backup.stat().st_size == 0:
            # Nothing migrated yet: the old release is still right for the schema.
            self.systemctl("start", *units, check=False)
            raise Refused(
                f"backup failed (rc {done.returncode}); units restarted, nothing migrated"
            )
        check = self.check_backup(backup)
        if check["verdict"] == "fail":
            # Still nothing migrated: a dump that does not restore is no way back.
            self.systemctl("start", *units, check=False)
            raise Refused(
                f"backup {backup} failed its restore check ({check['reason']}); "
                "units restarted, nothing migrated"
            )
        self.backup_check = check

        self.say(f"migrating as core: {', '.join(pending)}")
        result = self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "cli.admin_cli",
                "database",
                "migrate",
                "--write",
            ]
        )
        if result.returncode != 0 or self.database_status(sha).get(
            "pending_migrations"
        ):
            raise GovernorDecision(
                f"migration failed (rc {result.returncode}). Units are stopped; the old release "
                f"was not restarted. Backup: {backup}. Choose: restore the backup and redeploy "
                f"the old release, or fix forward."
            )
        return pending, str(backup)

    def check_backup(self, backup: Path) -> dict[str, object]:
        """The pre-migration dump, proved restorable before anything migrates
        (#1113). ``pg_restore --list`` must read it; then it is restored into
        a throwaway cluster (a container of the server's own image, no
        network, removed afterwards) and every table's row count must equal
        the live table's, counted read-only right after the dump while every
        unit is stopped. Verdict "fail" refuses the deploy; "unchecked" (no
        PSQL_COMMAND or RESTORE_IMAGE in deploy.conf) only warns. The result
        is written next to the dump as ``<dump>.check.json``, whatever it is."""
        check: dict[str, object] = {"dump": str(backup)}
        listed = self.host.run(["pg_restore", "--list", str(backup)], check=False)
        entries = [
            line
            for line in listed.stdout.decode(errors="replace").splitlines()
            if line.strip() and not line.startswith(";")
        ]
        if listed.returncode != 0 or not entries:
            check["list"] = f"unreadable (rc {listed.returncode})"
            return self._checked(
                backup, check, "fail", "pg_restore --list cannot read it", listed
            )
        check["list"] = f"ok ({len(entries)} entries)"

        conf = read_env_file(self.layout.deploy_conf)
        psql, image = conf.get("PSQL_COMMAND"), conf.get("RESTORE_IMAGE")
        if not psql or not image:
            self.say(
                "WARNING: no restore check (PSQL_COMMAND and RESTORE_IMAGE missing from "
                f"{self.layout.deploy_conf}); the dump was only listed"
            )
            return self._checked(
                backup, check, "unchecked", "restore check not configured"
            )

        live_run = self.host.run(
            ["/bin/sh", "-c", f"{psql} -XAtq -v ON_ERROR_STOP=1"],
            input=f"BEGIN TRANSACTION READ ONLY;\n{ROW_COUNT_SQL}COMMIT;\n".encode(),
            check=False,
        )
        live = parse_row_counts(live_run.stdout)
        if live_run.returncode != 0:
            return self._checked(
                backup,
                check,
                "fail",
                f"live row counts unreadable (rc {live_run.returncode})",
                live_run,
            )
        check["live_rows"] = live

        name = f"core-restore-check-{backup.stem}"
        self.say(f"restoring {backup.name} into a throwaway cluster ({image})")
        restored_run = self.host.run(
            [
                "/bin/sh",
                "-c",
                'exec timeout "$1" docker run --rm -i --name "$2" --network none '
                '--user postgres --entrypoint /bin/sh "$3" -c "$4" restore-check "$5" < "$6"',
                "restore",
                str(RESTORE_TIMEOUT_SEC),
                name,
                image,
                RESTORE_SCRIPT,
                ROW_COUNT_SQL,
                str(backup),
            ],
            check=False,
        )
        # A timed-out client can leave the container behind; never keep it.
        self.host.run(["docker", "rm", "-f", name], check=False)
        restored = parse_row_counts(restored_run.stdout)
        if restored_run.returncode != 0:
            return self._checked(
                backup,
                check,
                "fail",
                f"restore failed (rc {restored_run.returncode})",
                restored_run,
            )
        differ = {
            table: {"live": live.get(table), "restored": restored.get(table)}
            for table in sorted(set(live) | set(restored))
            if live.get(table) != restored.get(table)
        }
        if differ:
            check["differ"] = differ
            return self._checked(
                backup, check, "fail", f"row counts differ in {len(differ)} tables"
            )
        return self._checked(
            backup,
            check,
            "pass",
            f"{len(live)} tables, {sum(live.values())} rows, all equal to live",
        )

    def _checked(
        self,
        backup: Path,
        check: dict[str, object],
        verdict: str,
        reason: str,
        run: subprocess.CompletedProcess[bytes] | None = None,
    ) -> dict[str, object]:
        check["verdict"], check["reason"] = verdict, reason
        if run is not None and verdict == "fail":
            check["stderr"] = run.stderr.decode(errors="replace").strip()[-2000:]
        try:
            backup.with_name(backup.name + ".check.json").write_text(
                json.dumps(check, indent=2, sort_keys=True) + "\n", encoding="utf-8"
            )
        except OSError as exc:
            self.say(f"could not write the restore check record: {exc}")
        self.say(f"backup check: {verdict}: {reason}")
        return check

    # -- step 6 ---------------------------------------------------------------

    def readiness(self, sha: str) -> bool:
        port = self.options.readiness_port
        self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "uvicorn",
                "api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                str(port),
            ],
            unit=READINESS_UNIT,
            wait=False,
        )
        try:
            return self.wait_for_health(f"http://127.0.0.1:{port}/health")
        finally:
            self.systemctl("stop", f"{READINESS_UNIT}.service", check=False)

    def wait_for_health(self, url: str) -> bool:
        deadline = self.options.health_timeout
        waited = 0.0
        while waited <= deadline:
            try:
                if self.host.http_json(url, timeout=5) == {"status": "ok"}:
                    return True
            except Exception:
                pass
            self.host.sleep(self.options.poll_sec)
            waited += self.options.poll_sec
        return False

    # -- step 7 ---------------------------------------------------------------

    def alive_workers(self) -> set[str]:
        try:
            data = self.host.http_json(f"{self.options.api_base}/v1/daemon/status")
        except Exception:
            return set()
        workers = data.get("workers", []) if isinstance(data, dict) else []
        return {w["name"] for w in workers if w.get("alive") and w.get("name")}

    def verify_units(
        self, units: list[str], expect: set[str], since: datetime.datetime
    ) -> str | None:
        """None when every unit stayed active and every expected worker
        heartbeated after ``since``; otherwise what failed."""
        self.host.sleep(self.options.settle_sec)
        inactive = [
            u
            for u in units
            if self.systemctl("is-active", u, check=False).returncode != 0
        ]
        if inactive:
            return "inactive units: " + ", ".join(inactive)
        if not self.wait_for_health(f"{self.options.api_base}/health"):
            return "API /health did not answer"
        waited = 0.0
        missing = set(expect)
        while missing and waited <= self.options.heartbeat_timeout:
            try:
                data = self.host.http_json(f"{self.options.api_base}/v1/daemon/status")
                for w in data.get("workers", []) if isinstance(data, dict) else []:
                    beat = _parse_time(w.get("last_heartbeat"))
                    if w.get("name") in missing and beat is not None and beat > since:
                        missing.discard(w["name"])
            except Exception:
                pass
            if missing:
                self.host.sleep(self.options.poll_sec)
                waited += self.options.poll_sec
        if missing:
            return "no heartbeat since the switch from: " + ", ".join(sorted(missing))
        return None

    def restart(self, units: list[str]) -> None:
        self.systemctl("restart", *units, check=False)

    # -- step 3a: law ---------------------------------------------------------

    def law_changes(self, base: str, target: str) -> list[tuple[str, str]]:
        """(status, path) of governed text that differs from *base* to *target*."""
        out = self.git(
            "diff",
            "--name-status",
            "--no-renames",
            "-z",
            base,
            target,
            "--",
            *GOVERNED_PATHSPECS,
        ).decode()
        fields = [f for f in out.split("\0") if f]
        return [(fields[i][0], fields[i + 1]) for i in range(0, len(fields) - 1, 2)]

    def sync_law(self, target: str, base: str | None, venv_sha: str, why: str) -> bool:
        """Apply governed text at *target* (changed since *base*) through core-law.

        Runs the ``core-admin`` of release *venv_sha*. Returns whether law
        changed; a refusal raises Refused before anything switched.
        """
        if base is None:
            self.say("law: no live commit to compare with; law left as it is")
            return False
        changes = self.law_changes(base, target)
        writes: dict[str, bytes] = {}
        removals: list[str] = []
        for status, path in changes:
            if status == "D":
                removals.append(path)
            else:
                writes[path] = self.git("show", f"{target}:{path}")
        claude_writes, claude_removals = self.claude_changes(target)
        writes.update(claude_writes)
        removals += claude_removals
        if not writes and not removals:
            return False
        proposal_id = f"merge-{target[:12]}"
        root = self.layout.build / f"law-{target[:12]}"
        shutil.rmtree(root, ignore_errors=True)
        files = root / proposal_id / "files"
        files.mkdir(parents=True)
        for path, data in writes.items():
            dest = files / path
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(data)
        who = (
            self.options.merged_by
            or self.git("log", "-1", "--format=%an", target).decode().strip()
        )
        md = (
            f"# {why}: {target}\n\nGoverned text at {target}, merged on GitHub by "
            f"{who}. The merge is the approval.\n\n## Declared warnings\n\n"
            f"- Applied by core-deploy for {target} ({why}).\n"
        )
        if removals:
            md += "\n## Remove\n\n" + "".join(f"- `{p}`\n" for p in removals)
        (root / proposal_id / "proposal.md").write_text(md)
        # Law is checked against the code it comes with: the target's tree,
        # not the development checkout, which lags main until the governor
        # fast-forwards it (2026-10-13: 354d17fd refused, its new worker
        # module "not under src/" of the dev tree). "data" filter: no
        # absolute paths, no links out, no devices.
        code = root / "code"
        code.mkdir()
        with tarfile.open(
            fileobj=io.BytesIO(self.git("archive", "--format=tar", target))
        ) as tar:
            tar.extractall(code, filter="data")
        for path in [root, *root.rglob("*")]:
            if not path.is_symlink():
                os.chmod(path, 0o755 if path.is_dir() else 0o644)
        core_admin = self.layout.releases / venv_sha / "venv" / "bin" / "core-admin"
        dev = str(self.options.dev_repo)
        result = self.host.run(
            [
                # The release finds its repository from the working directory
                # (or REPO_PATH); without one it looked inside its own venv
                # (2026-10-12, 048eb9fd: PermissionError on venv/.../var).
                "env",
                f"--chdir={dev}",
                f"REPO_PATH={dev}",
                # An environment variable, not an option: a rollback runs an
                # older core-admin, which ignores it (and checks against the
                # dev tree, as before) but would reject an unknown option.
                f"CORE_LAW_CODE_TREE={code}",
                str(core_admin),
                "law",
                "apply-merge",
                proposal_id,
                "--proposals-dir",
                str(root),
                "--merge-commit",
                target,
                "--merged-by",
                who,
                "--repo",
                str(self.options.dev_repo),
                "--write",
            ],
            user=LAW_USER,
            check=False,
        )
        shutil.rmtree(root, ignore_errors=True)
        if result.returncode != 0:
            raise Refused(
                f"law for {target[:12]} refused by core-law:\n"
                + (result.stdout + result.stderr)
                .decode(errors="replace")
                .strip()[-2000:]
            )
        self.say(
            f"law: {len(writes) + len(removals)} governed file(s) applied for "
            f"{target[:12]} ({why})"
        )
        return True

    def claude_changes(self, target: str) -> tuple[dict[str, bytes], list[str]]:
        """What makes the dev tree's ``.claude/`` equal to *target*'s
        ``infra/claude-hooks/``: (path -> bytes to write, paths to remove).

        Compared by content, not by diff, so a copy that drifted, or a source
        that a deploy before this one did not install, is put right. A commit
        whose source has no ``settings.json`` does not define the set (older
        commits): ``.claude/`` is left as it is.
        """
        prefix = f"{CLAUDE_SOURCE}/"
        listed = self.git(
            "ls-tree", "-r", "-z", "--name-only", target, "--", prefix
        ).decode()
        names = sorted(
            p[len(prefix) :]
            for p in listed.split("\0")
            if p.startswith(prefix) and "/" not in p[len(prefix) :]
        )
        if "settings.json" not in names:
            return {}, []
        installed = self.options.dev_repo / ".claude"
        writes: dict[str, bytes] = {}
        for name in names:
            path = (
                ".claude/settings.json"
                if name == "settings.json"
                else f".claude/hooks/{name}"
            )
            data = self.git("show", f"{target}:{prefix}{name}")
            current = self.options.dev_repo / path
            if not (current.is_file() and current.read_bytes() == data):
                writes[path] = data
        hooks = installed / "hooks"
        removals = (
            sorted(
                f".claude/hooks/{p.name}"
                for p in hooks.iterdir()
                if p.is_file() and p.name not in names
            )
            if hooks.is_dir()
            else []
        )
        return writes, removals

    # -- host scripts and host setup -------------------------------------------

    def host_setup_changes(self, previous: str | None, sha: str) -> list[str]:
        """Host setup paths (sudoers, accounts, units) the merge changes."""
        if previous is None:
            return []
        return [
            line
            for line in self.git(
                "diff", "--name-only", previous, sha, "--", *HOST_SETUP_PATHS
            )
            .decode()
            .splitlines()
            if line
        ]

    def governor_account(self) -> str:
        """The Governor's account (core-darek): the one member of ``core-gov``."""
        members = self.host.group_members(GOVERNOR_GROUP)
        if len(members) != 1:
            raise Refused(
                f"host setup needs the governor account: group {GOVERNOR_GROUP} "
                f"must have exactly one member, has {members or 'none'}"
            )
        return members[0]

    def apply_host_setup(self, sha: str, changed: list[str]) -> list[str]:
        """Run, as root, the deployed commit's setup scripts for *changed*.

        Before anything is built; a failure refuses the deploy. Each script
        is safe to run again and fetches what it installs from GitHub at
        *sha*. Returns the scripts run.
        """
        ran: list[str] = []
        for name, interpreter, paths in PRE_SWITCH_SETUP:
            if not any(c == p or c.startswith(f"{p}/") for c in changed for p in paths):
                continue
            argv = ["--ref", sha]
            if name == "core-runtime-setup":
                argv += ["--governor", self.governor_account(), "--apply"]
            folder = Path(tempfile.mkdtemp(prefix="core-setup-"))
            try:
                script = folder / name
                script.write_bytes(self.git("show", f"{sha}:infra/{name}"))
                os.chmod(script, 0o700)
                self.say(f"host setup: {name} from {sha[:12]}")
                result = self.host.run(
                    [interpreter, str(script), *argv], input=b"", check=False
                )
            finally:
                shutil.rmtree(folder, ignore_errors=True)
            if result.returncode != 0:
                raise Refused(
                    f"host setup {name} failed for {sha[:12]}; nothing deployed:\n"
                    + (result.stdout + result.stderr)
                    .decode(errors="replace")
                    .strip()[-2000:]
                )
            ran.append(name)
        return ran

    def law_wheel(self) -> str | None:
        """The wheel_sha256 core-law's venv records; None when it has no
        record (core-law not set up here), "" when the record is unreadable."""
        record = self.options.law_venv / "core-release.json"
        if not record.exists():
            return None
        try:
            return str(json.loads(record.read_text(encoding="utf-8"))["wheel_sha256"])
        except (OSError, ValueError, KeyError, TypeError):
            return ""

    def apply_law_setup(self, changed: list[str], wheel_sha: str) -> str | None:
        """Run the installed (just updated) core-law-setup when the merge
        changed it or core-law's venv holds another wheel than this release:
        the custodian runs the code the services run. After the switch: it
        installs the live release's wheel. A failure is reported and never
        undoes the deploy."""
        law_wheel = self.law_wheel()
        stale = law_wheel is not None and law_wheel != wheel_sha
        if LAW_SETUP_PATH not in changed and not stale:
            return None
        try:
            result = self.host.run(
                [
                    str(self.layout.sbin / "core-law-setup"),
                    "--governor",
                    self.governor_account(),
                    "--apply",
                ],
                input=b"",
                check=False,
            )
        except Refused as exc:
            self.say(f"core-law-setup not run: {exc}")
            return "not run"
        if result.returncode != 0:
            self.say(
                "core-law-setup failed:\n"
                + (result.stdout + result.stderr)
                .decode(errors="replace")
                .strip()[-2000:]
            )
            return "failed"
        self.say("host setup: core-law-setup applied")
        return "applied"

    def update_host_scripts(self, sha: str) -> list[str]:
        """Make the installed host scripts equal to the deployed commit's.

        Runs after a verified switch. A failure here never undoes the deploy;
        it is reported and the old script stays.
        """
        updated: list[str] = []
        for name in HOST_SCRIPTS:
            try:
                data = self.git("show", f"{sha}:infra/{name}")
            except Refused as exc:
                self.say(f"host script {name} not updated: {exc}")
                continue
            target = self.layout.sbin / name
            if target.is_file() and target.read_bytes() == data:
                continue
            staged = target.with_name(f".{name}.new")
            staged.write_bytes(data)
            os.chmod(staged, 0o755)
            self.host.chown(staged, "root")
            os.replace(staged, target)
            updated.append(name)
        if updated:
            self.say(f"host scripts updated from {sha[:12]}: {', '.join(updated)}")
        return updated

    def _dev_git(
        self, *args: str, check: bool = True
    ) -> subprocess.CompletedProcess[bytes]:
        dev = str(self.options.dev_repo)
        return self.host.run(
            ["git", "-C", dev, "-c", f"safe.directory={dev}", *SAFE_GIT, *args],
            user=ASSISTANT,
            check=check,
        )

    def follow_dev_checkout(self, sha: str) -> str | None:
        """Fast-forward the dev checkout to *sha* (step 8a). Returns what
        happened, for the ledger; None when there is nothing to do."""
        if not (self.options.dev_repo / ".git").exists():
            return None
        try:
            return self._follow_dev_checkout(sha)
        except (Refused, OSError, KeyError) as exc:
            self.say(f"dev checkout not moved: {exc}")
            return "not moved: git failed"

    def _follow_dev_checkout(self, sha: str) -> str | None:
        head = self._dev_git("rev-parse", "HEAD").stdout.decode().strip()
        if head == sha:
            return None
        if self._dev_git("cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode:
            self._dev_git("fetch", "--quiet", "origin", sha)
        if self._dev_git(
            "merge-base", "--is-ancestor", head, sha, check=False
        ).returncode:
            self.say(f"dev checkout not moved: {head[:12]} is not behind {sha[:12]}")
            return "not moved: not behind"

        def names(*args: str) -> list[str]:
            out = self._dev_git("diff", "--name-only", "--no-renames", "-z", *args)
            return [p for p in out.stdout.decode().split("\0") if p]

        changed = names(head, sha)
        # The working tree against the commit: what git would still have to write.
        differs = set(names(sha, "--", *changed)) if changed else set()
        settled = [p for p in changed if p not in differs]
        governed = [
            p
            for p in sorted(differs)
            if p.startswith((".intent/", ".specs/", ".claude/")) or p == "CLAUDE.md"
        ]
        if governed:
            self.say(
                "dev checkout not moved: governed text differs from "
                f"{sha[:12]}: {', '.join(governed[:5])}"
            )
            return "not moved: governed text differs"
        if settled:
            self._dev_git("add", "-A", "-f", "--", *settled)
        merged = self._dev_git("merge", "--ff-only", "--quiet", sha, check=False)
        if merged.returncode:
            self.say(
                "dev checkout not moved: "
                + merged.stderr.decode(errors="replace").strip()[-500:]
            )
            return "not moved: git refused"
        self.say(f"dev checkout moved {head[:12]} -> {sha[:12]}")
        return f"moved {head[:12]} -> {sha[:12]}"

    # -- step 8b: prune ------------------------------------------------------

    def prune_releases(self, current: str, previous: str | None) -> list[str] | str:
        """Delete releases nothing needs (step 8b). Returns the deleted
        shas, for the ledger, or what failed; never raises."""
        try:
            return self._prune_releases(current, previous)
        except Exception as exc:  # a prune never fails the deploy
            self.say(f"warning: old releases not pruned: {exc}")
            return f"failed: {exc}"

    def _prune_releases(self, current: str, previous: str | None) -> list[str]:
        releases = self.layout.releases
        built: dict[str, float] = {}
        with os.scandir(releases) as entries:
            for entry in entries:
                if entry.is_symlink() or not RELEASE_NAME.fullmatch(entry.name):
                    continue
                if not entry.is_dir(follow_symlinks=False):
                    continue
                stamp = Path(entry.path) / "venv" / "core-release.json"
                try:
                    built[entry.name] = stamp.lstat().st_mtime
                except FileNotFoundError:
                    built[entry.name] = entry.stat(follow_symlinks=False).st_mtime
        keep = {current, previous}
        keep.update(sorted(built, key=built.__getitem__, reverse=True)[:KEEP_NEWEST])
        keep.add(self.law_release())
        roots = {re.escape(str(releases)), re.escape(os.path.realpath(releases))}
        in_use = re.compile(rf"(?:{'|'.join(sorted(roots))})/([0-9a-f]{{40}})")
        for text in self.host.process_texts():
            keep.update(in_use.findall(text))
        deleted = []
        for sha in sorted(set(built) - keep):
            try:
                shutil.rmtree(releases / sha)
            except OSError as exc:
                self.say(f"warning: release {sha[:12]} not pruned: {exc}")
                continue
            deleted.append(sha)
        if deleted:
            self.say(
                f"pruned {len(deleted)} old release(s), kept {len(built) - len(deleted)}"
            )
        return deleted

    def law_release(self) -> str | None:
        """The release core-law's venv was installed from; None when it has
        none. An unreadable record raises: core-law's release is unknown."""
        record = self.options.law_venv / "core-release.json"
        if not record.exists():
            return None
        return str(json.loads(record.read_text(encoding="utf-8"))["sha"])

    # -- entry points ---------------------------------------------------------

    def deploy(self, ref: str) -> int:
        env = read_env_file(self.layout.core_env)
        upstream = env.get("CORE_UPSTREAM_URL")
        if not upstream:
            raise Refused(f"CORE_UPSTREAM_URL missing from {self.layout.core_env}")

        sha = self.resolve(ref, upstream)
        self.say(f"{ref} -> {sha}")
        if (self.layout.releases / sha).exists():
            raise Refused(
                f"release {sha[:12]} already exists; use --rollback or a new commit"
            )
        previous = self.current_sha()
        setup_changed = self.host_setup_changes(previous, sha)
        host_setup = self.apply_host_setup(sha, setup_changed)
        units = self.units()
        expect = self.alive_workers()

        wheel_sha = self.build_and_install(sha)
        law_changed = False
        try:
            # The build takes minutes: the governor's approval of the exact
            # head is read again right before the first step that changes
            # anything live (law, then the schema, then the switch).
            self.require_promotion(github_slug(upstream), sha)
            law_changed = self.sync_law(sha, previous, sha, "merge")
            migrated, backup = self.migrate(sha, units)
            if not self.readiness(sha):
                if migrated:
                    raise GovernorDecision(
                        f"new release failed readiness after migrating {migrated}. Units are "
                        f"stopped; the old release was not restarted. Backup: {backup}."
                    )
                raise Refused("new release failed readiness; nothing switched")
            units = self.with_declared(units, sha)
        except Refused:
            # Never switched: drop the release so a corrected re-run can install it.
            # (A GovernorDecision keeps it: the governor may choose to fix forward.)
            if law_changed and previous:
                self.sync_law(previous, sha, sha, "law put back")
            shutil.rmtree(self.layout.releases / sha, ignore_errors=True)
            raise

        switched_at = self.host.now()
        self.switch_current(sha)
        self.restart(units)
        failure = self.verify_units(units, expect, switched_at)
        if failure:
            if migrated:
                raise GovernorDecision(
                    f"after switching to {sha[:12]} (migrated {migrated}): {failure}. Not "
                    f"switching back automatically. Backup: {backup}."
                )
            if previous:
                if law_changed:
                    self.sync_law(previous, sha, sha, "law put back")
                self.switch_current(previous)
                self.restart(units)
                shutil.rmtree(self.layout.releases / sha, ignore_errors=True)
                raise Refused(f"{failure}; switched back to {previous[:12]}")
            raise Refused(f"{failure}; no previous release to switch back to")

        self.enable(units)
        scripts = self.update_host_scripts(sha)
        law_setup = self.apply_law_setup(setup_changed, wheel_sha)
        dev_checkout = self.follow_dev_checkout(sha)
        pruned = self.prune_releases(sha, previous)
        self.ledger(
            {
                "action": "deploy",
                "sha": sha,
                "ref": ref,
                "host_scripts_updated": scripts,
                "host_setup": host_setup,
                "law_setup": law_setup,
                "dev_checkout": dev_checkout,
                "pruned": pruned,
                "wheel_sha256": wheel_sha,
                "previous": previous,
                "migrations_applied": migrated,
                "backup": backup or None,
                "backup_check": self.backup_check,
                "law_applied": law_changed,
                "merged_by": self.options.merged_by,
                "promotion": self.options.promotion,
                "units": units,
                "at": switched_at.isoformat(),
                "by": os.environ.get("SUDO_USER", "root"),
            }
        )
        self.say(f"live: {sha} ({len(units)} units verified)")
        return 0

    def rollback(self) -> int:
        current = self.current_sha()
        if current is None:
            raise Refused("no current release")
        entry = next(
            (e for e in reversed(self.ledger_entries()) if e.get("sha") == current),
            None,
        )
        if entry is None or not entry.get("previous"):
            raise Refused(f"no previous release recorded for {current[:12]}")
        target = str(entry["previous"])
        if entry.get("migrations_applied"):
            raise Refused(
                f"migrations {entry['migrations_applied']} lie between {target[:12]} and "
                f"{current[:12]}; backup {entry.get('backup')}. A symlink does not roll back a database."
            )
        if not (self.layout.releases / target).is_dir():
            raise Refused(f"release {target[:12]} is no longer installed")
        units = self.units()
        expect = self.alive_workers()
        units = self.with_declared(units, target)
        law_changed = self.sync_law(target, current, current, "rollback")
        switched_at = self.host.now()
        self.switch_current(target)
        self.restart(units)
        failure = self.verify_units(units, expect, switched_at)
        if failure:
            if law_changed:
                self.sync_law(current, target, current, "law put back")
            self.switch_current(current)
            self.restart(units)
            raise Refused(f"{failure}; switched back to {current[:12]}")
        self.enable(units)
        self.ledger(
            {
                "action": "rollback",
                "sha": target,
                "previous": current,
                "migrations_applied": [],
                "units": units,
                "at": switched_at.isoformat(),
                "by": os.environ.get("SUDO_USER", "root"),
            }
        )
        self.say(f"rolled back to {target}")
        return 0


def main(argv: list[str] | None = None, host: Host | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="core-deploy", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument(
        "ref", nargs="?", help="tag or full commit sha on upstream develop"
    )
    parser.add_argument(
        "--migrate", action="store_true", help="apply pending migrations"
    )
    parser.add_argument(
        "--rollback", action="store_true", help="return to the previous release"
    )
    parser.add_argument(
        "--merged-by",
        help="who merged the commit on GitHub (the post-merge runner passes it)",
    )
    parser.add_argument(
        "--promotion",
        type=int,
        help="the promotion pull request (into live) the governor approved",
    )
    parser.add_argument(
        "--pipeline-conf",
        type=Path,
        default=Path("/etc/core/pipeline.conf"),
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--root", type=Path, default=Path("/opt/core"), help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--sbin", type=Path, default=Path("/usr/local/sbin"), help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--dev-repo", type=Path, default=DEV_REPO, help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--law-venv",
        type=Path,
        default=Path("/opt/core-law/venv"),
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args(argv)
    if bool(args.ref) == bool(args.rollback):
        parser.error("give exactly one of <ref> or --rollback")
    if host is None and os.geteuid() != 0:
        print("core-deploy: must run as root (sudo core-deploy ...)", file=sys.stderr)
        return EX_REFUSED

    layout = Layout(args.root, args.sbin)
    deployer = Deployer(
        host or Host(),
        layout,
        Options(
            migrate=args.migrate,
            merged_by=args.merged_by,
            promotion=args.promotion,
            pipeline_conf=args.pipeline_conf,
            dev_repo=args.dev_repo,
            law_venv=args.law_venv,
        ),
    )
    layout.root.mkdir(parents=True, exist_ok=True)
    with layout.lock.open("a") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("core-deploy: another deployment is running", file=sys.stderr)
            return EX_REFUSED
        try:
            return deployer.rollback() if args.rollback else deployer.deploy(args.ref)
        except Refused as exc:
            print(f"core-deploy: refused: {exc}", file=sys.stderr)
            return EX_REFUSED
        except GovernorDecision as exc:
            print(
                f"core-deploy: STOPPED, governor decision needed: {exc}",
                file=sys.stderr,
            )
            return EX_GOVERNOR


if __name__ == "__main__":
    sys.exit(main())
