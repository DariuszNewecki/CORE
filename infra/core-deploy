# Restore check of the pre-migration dump (#1113). One line per table,
# "schema.table|rows", from a count query psql's \gexec runs (no libxml,
# no function, nothing written); run read-only on the live database right after the
# dump (every unit stopped, so these are the counts at dump time) and on the
# throwaway copy restored from it.
ROW_COUNT_SQL = """\
SELECT string_agg(format('SELECT %L || ''|'' || count(*) FROM %I.%I',
    format('%I.%I', n.nspname, c.relname), n.nspname, c.relname), ' UNION ALL ')
  || ' ORDER BY 1'
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('r', 'p')
  AND n.nspname <> 'information_schema' AND n.nspname NOT LIKE 'pg\\_%'
\\gexec
"""
# Runs inside a throwaway container of the database server's own image, no
# network, removed afterwards: a new cluster in a temp dir, the dump (stdin)
# restored into it, then ROW_COUNT_SQL ($1). Never touches the live server.
RESTORE_SCRIPT = """\
set -eu
d="$(mktemp -d)"
initdb -D "$d/data" -U postgres -A trust --no-sync >/dev/null
pg_ctl -D "$d/data" -l "$d/log" -s -w \
  -o "-c listen_addresses='' -c unix_socket_directories=$d -c fsync=off" start
createdb -h "$d" -U postgres restore_check
pg_restore -h "$d" -U postgres -d restore_check --no-owner --no-privileges --exit-on-error
printf '%s' "$1" | psql -h "$d" -U postgres -d restore_check -XAtq -v ON_ERROR_STOP=1
"""
RESTORE_TIMEOUT_SEC = 3600

