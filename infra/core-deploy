@dataclass
class Deployer:
    host: Host
    layout: Layout
    options: Options = field(default_factory=Options)

    # -- small wrappers -----------------------------------------------------

    def say(self, message: str) -> None:
        print(f"core-deploy: {message}", flush=True)

    def git(self, *args: str, input: bytes | None = None) -> bytes:
        return self.host.run(
            ["git", "-C", str(self.layout.repo), *SAFE_GIT, *args],
            user=SERVICE_USER,
            input=input,
        ).stdout

    def systemctl(
        self, *args: str, check: bool = True
    ) -> subprocess.CompletedProcess[bytes]:
        return self.host.run(
            ["systemctl", "--user", "-M", f"{SERVICE_USER}@", *args], check=check
        )

    def as_service(
        self, cmd: list[str], *, unit: str | None = None, wait: bool = True
    ) -> subprocess.CompletedProcess[bytes]:
        """Run in core's user manager with the units' own environment."""
        argv = [
            "systemd-run",
            "--user",
            "-M",
            f"{SERVICE_USER}@",
            "--collect",
            "--quiet",
            f"--property=EnvironmentFile={self.layout.core_env}",
            f"--property=WorkingDirectory={self.layout.run}",
        ]
        if unit:
            argv.append(f"--unit={unit}")
        if wait:
            argv += ["--wait", "--pipe"]
        return self.host.run([*argv, "--", *cmd], check=False)

    def units(self) -> list[str]:
        out = self.systemctl(
            "list-units", "--all", "--plain", "--no-legend", "--type=service", "core-*"
        ).stdout.decode()
        names = {line.split()[0] for line in out.splitlines() if line.strip()}
        if not names:
            # Nothing loaded (a first deploy, or every service down): restart
            # starts them, so take the enabled ones default.target wants.
            wants = self.systemctl(
                "show", "default.target", "--property=Wants", "--value", check=False
            ).stdout.decode()
            names = {
                n
                for n in wants.split()
                if n.startswith("core-") and n.endswith(".service")
            }
        return [n for n in sorted(names) if not n.startswith(READINESS_UNIT)]

    def current_sha(self) -> str | None:
        if not self.layout.current.is_symlink():
            return None
        return Path(os.readlink(self.layout.current)).name

    def switch_current(self, sha: str) -> None:
        tmp = self.layout.root / ".current.tmp"
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        tmp.symlink_to(Path("releases") / sha)
        os.replace(tmp, self.layout.current)

    def ledger(self, entry: dict[str, object]) -> None:
        with self.layout.ledger.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, sort_keys=True) + "\n")

    def ledger_entries(self) -> list[dict[str, object]]:
        if not self.layout.ledger.is_file():
            return []
        return [
            json.loads(line)
            for line in self.layout.ledger.read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]

    # -- step 1 ---------------------------------------------------------------

    def branch(self) -> str:
        return read_env_file(self.layout.deploy_conf).get("DEPLOY_BRANCH") or "develop"

    def resolve(self, ref: str, upstream: str) -> str:
        if not valid_ref(ref):
            raise Refused(f"not a valid tag or sha: {ref!r}")
        branch = self.branch()
        upstream_ref = f"refs/remotes/upstream/{branch}"
        self.git("fetch", "--no-tags", upstream, f"refs/heads/{branch}:{upstream_ref}")
        if not re.fullmatch(r"[0-9a-f]{40}", ref):
            self.git("fetch", "--no-tags", upstream, f"refs/tags/{ref}:refs/tags/{ref}")
        sha = self.git("rev-parse", "--verify", f"{ref}^{{commit}}").decode().strip()
        on_develop = self.host.run(
            [
                "git",
                "-C",
                str(self.layout.repo),
                *SAFE_GIT,
                "merge-base",
                "--is-ancestor",
                sha,
                upstream_ref,
            ],
            user=SERVICE_USER,
            check=False,
        )
        if on_develop.returncode != 0:
            raise Refused(f"{sha[:12]} is not on upstream {branch}")
        tested = self.options.tested_as
        if tested:
            # A merge commit on main has no CI run of its own (CI runs on the
            # pull request). It is accepted when its tree is byte-identical to
            # the tested pull-request head, which branch protection keeps up
            # to date with main.
            if not re.fullmatch(r"[0-9a-f]{40}", tested):
                raise Refused(f"--tested-as must be a full sha, not {tested!r}")
            trees = {
                self.git("rev-parse", "--verify", f"{c}^{{tree}}").decode().strip()
                for c in (sha, tested)
            }
            if len(trees) != 1:
                raise Refused(
                    f"{sha[:12]} does not have the same tree as the tested {tested[:12]}"
                )
            self.require_green_ci(github_slug(upstream), tested)
        else:
            self.require_green_ci(github_slug(upstream), sha)
        return sha

    def require_green_ci(self, slug: str, sha: str) -> None:
        url = f"{self.options.github_api}/repos/{slug}/commits/{sha}/check-runs?per_page=100"
        try:
            data = self.host.http_json(url)
        except Exception as exc:  # network, rate limit, parse
            raise Refused(f"CI state for {sha[:12]} unavailable: {exc}") from exc
        runs = data.get("check_runs", []) if isinstance(data, dict) else []
        if not runs:
            raise Refused(f"no CI check runs for {sha[:12]}")
        bad = [
            f"{r.get('name')}: {r.get('status')}/{r.get('conclusion')}"
            for r in runs
            if r.get("status") != "completed" or r.get("conclusion") not in GREEN
        ]
        if bad:
            raise Refused(f"CI for {sha[:12]} is not green: " + "; ".join(bad))

    # -- step 3 ---------------------------------------------------------------

    def build_and_install(self, sha: str) -> str:
        build = self.layout.build / sha
        if build.exists():
            shutil.rmtree(build)
        (build / "src").mkdir(parents=True)
        (build / "wheel").mkdir()
        (build / "wheelhouse").mkdir()

        archive = self.git("archive", "--format=tar", sha)
        lock = self.git("show", f"{sha}:poetry.lock")
        pyproject = self.git("show", f"{sha}:pyproject.toml")
        requirements = build / "requirements.txt"
        requirements.write_text(requirements_from_lock(lock), encoding="utf-8")
        self.host.chown(build, BUILD_USER, recursive=True)

        self.say("building as core-build")
        self.host.run(
            ["tar", "-x", "-C", str(build / "src")], user=BUILD_USER, input=archive
        )
        self.host.run(
            ["/usr/bin/python3", "-I", "-m", "venv", str(build / "tools")],
            user=BUILD_USER,
        )
        pip = str(build / "tools" / "bin" / "pip")
        self.host.run(
            [
                pip,
                "wheel",
                "--no-cache-dir",
                "--no-deps",
                "--wheel-dir",
                str(build / "wheel"),
                str(build / "src"),
            ],
            user=BUILD_USER,
        )
        self.host.run(
            [
                pip,
                "download",
                "--no-cache-dir",
                "--only-binary=:all:",
                "--require-hashes",
                "-r",
                str(requirements),
                "-d",
                str(build / "wheelhouse"),
            ],
            user=BUILD_USER,
        )
        wheels = sorted((build / "wheel").glob("*.whl"))
        if len(wheels) != 1:
            raise Refused(f"expected one built wheel, found {[w.name for w in wheels]}")
        verify_wheel(wheels[0], archive, pyproject)
        wheel_sha = sha256_file(wheels[0])

        self.say("installing as root (wheels only)")
        release = self.layout.releases / sha
        venv = release / "venv"
        try:
            self.host.run(["/usr/bin/python3", "-I", "-m", "venv", str(venv)])
            python = str(venv / "bin" / "python")
            self.host.run(
                [
                    python,
                    "-I",
                    "-m",
                    "pip",
                    "install",
                    "--no-cache-dir",
                    "--no-index",
                    "--only-binary=:all:",
                    "--require-hashes",
                    "--find-links",
                    str(build / "wheelhouse"),
                    "-r",
                    str(requirements),
                ]
            )
            self.host.run(
                [
                    python,
                    "-I",
                    "-m",
                    "pip",
                    "install",
                    "--no-cache-dir",
                    "--no-index",
                    "--no-deps",
                    str(wheels[0]),
                ]
            )
            (venv / "core-release.json").write_text(
                json.dumps({"sha": sha, "wheel_sha256": wheel_sha}) + "\n",
                encoding="utf-8",
            )
            self.host.run(["chown", "-R", "root:root", str(release)])
            self.host.run(["chmod", "-R", "go-w", str(release)])
        except BaseException:
            shutil.rmtree(release, ignore_errors=True)
            raise
        shutil.rmtree(build, ignore_errors=True)
        return wheel_sha

    def release_python(self, sha: str) -> str:
        return str(self.layout.releases / sha / "venv" / "bin" / "python")

    # -- steps 4-5 ------------------------------------------------------------

    def database_status(self, sha: str) -> dict[str, object]:
        result = self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "cli.admin_cli",
                "database",
                "status",
                "--format",
                "json",
            ]
        )
        try:
            status = json.loads(result.stdout.decode())
        except ValueError as exc:
            raise Refused(
                f"database status unreadable (rc {result.returncode})"
            ) from exc
        if not status.get("connected"):
            raise Refused(f"database not reachable: {status.get('error')}")
        if status.get("probe_failures"):
            raise Refused(f"schema probe failures: {status['probe_failures']}")
        return status

    def migrate(self, sha: str, units: list[str]) -> tuple[list[str], str]:
        status = self.database_status(sha)
        raw = status.get("pending_migrations")
        pending = [str(p) for p in raw] if isinstance(raw, list) else []
        if not pending:
            return [], ""
        if not self.options.migrate:
            raise Refused(
                "pending migrations (re-run with --migrate): " + ", ".join(pending)
            )
        backup_cmd = read_env_file(self.layout.deploy_conf).get("BACKUP_COMMAND")
        if not backup_cmd or "{out}" not in backup_cmd:
            raise Refused(
                "--migrate needs BACKUP_COMMAND (with {out}) in "
                + str(self.layout.deploy_conf)
            )

        self.say("stopping every unit for the migration")
        self.systemctl("stop", *units)
        stamp = self.host.now().strftime("%Y%m%dT%H%M%SZ")
        backup = self.layout.backups / f"{stamp}-pre-{sha[:12]}.dump"
        self.layout.backups.mkdir(parents=True, exist_ok=True)
        done = self.host.run(
            ["/bin/sh", "-c", backup_cmd.replace("{out}", str(backup))], check=False
        )
        if done.returncode != 0 or not backup.is_file() or backup.stat().st_size == 0:
            # Nothing migrated yet: the old release is still right for the schema.
            self.systemctl("start", *units, check=False)
            raise Refused(
                f"backup failed (rc {done.returncode}); units restarted, nothing migrated"
            )

        self.say(f"migrating as core: {', '.join(pending)}")
        result = self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "cli.admin_cli",
                "database",
                "migrate",
                "--write",
            ]
        )
        if result.returncode != 0 or self.database_status(sha).get(
            "pending_migrations"
        ):
            raise GovernorDecision(
                f"migration failed (rc {result.returncode}). Units are stopped; the old release "
                f"was not restarted. Backup: {backup}. Choose: restore the backup and redeploy "
                f"the old release, or fix forward."
            )
        return pending, str(backup)

    # -- step 6 ---------------------------------------------------------------

    def readiness(self, sha: str) -> bool:
        port = self.options.readiness_port
        self.as_service(
            [
                self.release_python(sha),
                "-I",
                "-m",
                "uvicorn",
                "api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                str(port),
            ],
            unit=READINESS_UNIT,
            wait=False,
        )
        try:
            return self.wait_for_health(f"http://127.0.0.1:{port}/health")
        finally:
            self.systemctl("stop", f"{READINESS_UNIT}.service", check=False)

    def wait_for_health(self, url: str) -> bool:
        deadline = self.options.health_timeout
        waited = 0.0
        while waited <= deadline:
            try:
                if self.host.http_json(url, timeout=5) == {"status": "ok"}:
                    return True
            except Exception:
                pass
            self.host.sleep(self.options.poll_sec)
            waited += self.options.poll_sec
        return False

    # -- step 7 ---------------------------------------------------------------

    def alive_workers(self) -> set[str]:
        try:
            data = self.host.http_json(f"{self.options.api_base}/v1/daemon/status")
        except Exception:
            return set()
        workers = data.get("workers", []) if isinstance(data, dict) else []
        return {w["name"] for w in workers if w.get("alive") and w.get("name")}

    def verify_units(
        self, units: list[str], expect: set[str], since: datetime.datetime
    ) -> str | None:
        """None when every unit stayed active and every expected worker
        heartbeated after ``since``; otherwise what failed."""
        self.host.sleep(self.options.settle_sec)
        inactive = [
            u
            for u in units
            if self.systemctl("is-active", u, check=False).returncode != 0
        ]
        if inactive:
            return "inactive units: " + ", ".join(inactive)
        if not self.wait_for_health(f"{self.options.api_base}/health"):
            return "API /health did not answer"
        waited = 0.0
        missing = set(expect)
        while missing and waited <= self.options.heartbeat_timeout:
            try:
                data = self.host.http_json(f"{self.options.api_base}/v1/daemon/status")
                for w in data.get("workers", []) if isinstance(data, dict) else []:
                    beat = _parse_time(w.get("last_heartbeat"))
                    if w.get("name") in missing and beat is not None and beat > since:
                        missing.discard(w["name"])
            except Exception:
                pass
            if missing:
                self.host.sleep(self.options.poll_sec)
                waited += self.options.poll_sec
        if missing:
            return "no heartbeat since the switch from: " + ", ".join(sorted(missing))
        return None

    def restart(self, units: list[str]) -> None:
        self.systemctl("restart", *units, check=False)

    # -- step 3a: law ---------------------------------------------------------

    def law_changes(self, base: str, target: str) -> list[tuple[str, str]]:
        """(status, path) of governed text that differs from *base* to *target*."""
        out = self.git(
            "diff",
            "--name-status",
            "--no-renames",
            "-z",
            base,
            target,
            "--",
            *GOVERNED_PATHSPECS,
        ).decode()
        fields = [f for f in out.split("\0") if f]
        return [(fields[i][0], fields[i + 1]) for i in range(0, len(fields) - 1, 2)]

    def sync_law(self, target: str, base: str | None, venv_sha: str, why: str) -> bool:
        """Apply governed text at *target* (changed since *base*) through core-law.

        Runs the ``core-admin`` of release *venv_sha*. Returns whether law
        changed; a refusal raises Refused before anything switched.
        """
        if base is None:
            self.say("law: no live commit to compare with; law left as it is")
            return False
        changes = self.law_changes(base, target)
        if not changes:
            return False
        proposal_id = f"merge-{target[:12]}"
        root = self.layout.build / f"law-{target[:12]}"
        shutil.rmtree(root, ignore_errors=True)
        files = root / proposal_id / "files"
        files.mkdir(parents=True)
        removals: list[str] = []
        for status, path in changes:
            if status == "D":
                removals.append(path)
                continue
            dest = files / path
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(self.git("show", f"{target}:{path}"))
        who = (
            self.options.merged_by
            or self.git("log", "-1", "--format=%an", target).decode().strip()
        )
        md = (
            f"# {why}: {target}\n\nGoverned text at {target}, merged on GitHub by "
            f"{who}. The merge is the approval.\n\n## Declared warnings\n\n"
            f"- Applied by core-deploy for {target} ({why}).\n"
        )
        if removals:
            md += "\n## Remove\n\n" + "".join(f"- `{p}`\n" for p in removals)
        (root / proposal_id / "proposal.md").write_text(md)
        # Law is checked against the code it comes with: the target's tree,
        # not the development checkout, which lags main until the governor
        # fast-forwards it (2026-10-13: 354d17fd refused, its new worker
        # module "not under src/" of the dev tree). "data" filter: no
        # absolute paths, no links out, no devices.
        code = root / "code"
        code.mkdir()
        with tarfile.open(
            fileobj=io.BytesIO(self.git("archive", "--format=tar", target))
        ) as tar:
            tar.extractall(code, filter="data")
        for path in [root, *root.rglob("*")]:
            if not path.is_symlink():
                os.chmod(path, 0o755 if path.is_dir() else 0o644)
        core_admin = self.layout.releases / venv_sha / "venv" / "bin" / "core-admin"
        dev = str(self.options.dev_repo)
        result = self.host.run(
            [
                # The release finds its repository from the working directory
                # (or REPO_PATH); without one it looked inside its own venv
                # (2026-10-12, 048eb9fd: PermissionError on venv/.../var).
                "env",
                f"--chdir={dev}",
                f"REPO_PATH={dev}",
                # An environment variable, not an option: a rollback runs an
                # older core-admin, which ignores it (and checks against the
                # dev tree, as before) but would reject an unknown option.
                f"CORE_LAW_CODE_TREE={code}",
                str(core_admin),
                "law",
                "apply-merge",
                proposal_id,
                "--proposals-dir",
                str(root),
                "--merge-commit",
                target,
                "--merged-by",
                who,
                "--repo",
                str(self.options.dev_repo),
                "--write",
            ],
            user=LAW_USER,
            check=False,
        )
        shutil.rmtree(root, ignore_errors=True)
        if result.returncode != 0:
            raise Refused(
                f"law for {target[:12]} refused by core-law:\n"
                + (result.stdout + result.stderr)
                .decode(errors="replace")
                .strip()[-2000:]
            )
        self.say(
            f"law: {len(changes)} governed file(s) applied for {target[:12]} ({why})"
        )
        return True

    # -- host scripts and host setup -------------------------------------------

    def refuse_host_setup_changes(self, previous: str | None, sha: str) -> None:
        """Refuse a merge that changes sudoers, accounts or units (the
        governor's to apply), unless --host-setup-applied says it is done."""
        if previous is None or self.options.host_setup_applied:
            return
        changed = [
            line
            for line in self.git(
                "diff", "--name-only", previous, sha, "--", *HOST_SETUP_PATHS
            )
            .decode()
            .splitlines()
            if line
        ]
        if changed:
            raise Refused(
                "this merge changes the host setup (sudoers, accounts or units): "
                + ", ".join(changed)
                + ". Nothing was deployed. Apply it yourself: "
                f"sudo bash infra/core-one-path-setup --ref {sha} (or the setup "
                f"script named above), then: sudo core-deploy {sha} "
                "--migrate --host-setup-applied"
            )

    def update_host_scripts(self, sha: str) -> list[str]:
        """Make the installed host scripts equal to the deployed commit's.

        Runs after a verified switch. A failure here never undoes the deploy;
        it is reported and the old script stays.
        """
        updated: list[str] = []
        for name in HOST_SCRIPTS:
            try:
                data = self.git("show", f"{sha}:infra/{name}")
            except Refused as exc:
                self.say(f"host script {name} not updated: {exc}")
                continue
            target = self.layout.sbin / name
            if target.is_file() and target.read_bytes() == data:
                continue
            staged = target.with_name(f".{name}.new")
            staged.write_bytes(data)
            os.chmod(staged, 0o755)
            self.host.chown(staged, "root")
            os.replace(staged, target)
            updated.append(name)
        if updated:
            self.say(f"host scripts updated from {sha[:12]}: {', '.join(updated)}")
        return updated

    def update_claude_md(self, sha: str) -> bool:
        """Make the dev tree's CLAUDE.md equal to the deployed commit's.

        CLAUDE.md is no longer governed text, but core-law-setup still gives it
        to core-law, so nothing else can write it. Runs after a verified switch;
        a failure is reported and never undoes the deploy.
        """
        target = self.options.dev_repo / "CLAUDE.md"
        if not self.options.dev_repo.is_dir():
            return False
        staged = self.layout.root / ".CLAUDE.md.new"
        try:
            data = self.git("show", f"{sha}:CLAUDE.md")
            if target.is_file() and target.read_bytes() == data:
                return False
            staged.write_bytes(data)
            self.host.run(["cp", "-T", str(staged), str(target)])
            self.host.run(["chown", f"{LAW_USER}:{LAW_USER}", str(target)])
            self.host.run(["chmod", "0644", str(target)])
        except (Refused, OSError) as exc:
            self.say(f"CLAUDE.md not updated: {exc}")
            return False
        finally:
            staged.unlink(missing_ok=True)
        self.say(f"CLAUDE.md updated from {sha[:12]}")
        return True

    # -- entry points ---------------------------------------------------------

    def deploy(self, ref: str) -> int:
        env = read_env_file(self.layout.core_env)
        upstream = env.get("CORE_UPSTREAM_URL")
        if not upstream:
            raise Refused(f"CORE_UPSTREAM_URL missing from {self.layout.core_env}")

        sha = self.resolve(ref, upstream)
        self.say(f"{ref} -> {sha}")
        if (self.layout.releases / sha).exists():
            raise Refused(
                f"release {sha[:12]} already exists; use --rollback or a new commit"
            )
        previous = self.current_sha()
        self.refuse_host_setup_changes(previous, sha)
        units = self.units()
        expect = self.alive_workers()

        wheel_sha = self.build_and_install(sha)
        law_changed = False
        try:
            law_changed = self.sync_law(sha, previous, sha, "merge")
            migrated, backup = self.migrate(sha, units)
            if not self.readiness(sha):
                if migrated:
                    raise GovernorDecision(
                        f"new release failed readiness after migrating {migrated}. Units are "
                        f"stopped; the old release was not restarted. Backup: {backup}."
                    )
                raise Refused("new release failed readiness; nothing switched")
        except Refused:
            # Never switched: drop the release so a corrected re-run can install it.
            # (A GovernorDecision keeps it: the governor may choose to fix forward.)
            if law_changed and previous:
                self.sync_law(previous, sha, sha, "law put back")
            shutil.rmtree(self.layout.releases / sha, ignore_errors=True)
            raise

        switched_at = self.host.now()
        self.switch_current(sha)
        self.restart(units)
        failure = self.verify_units(units, expect, switched_at)
        if failure:
            if migrated:
                raise GovernorDecision(
                    f"after switching to {sha[:12]} (migrated {migrated}): {failure}. Not "
                    f"switching back automatically. Backup: {backup}."
                )
            if previous:
                if law_changed:
                    self.sync_law(previous, sha, sha, "law put back")
                self.switch_current(previous)
                self.restart(units)
                shutil.rmtree(self.layout.releases / sha, ignore_errors=True)
                raise Refused(f"{failure}; switched back to {previous[:12]}")
            raise Refused(f"{failure}; no previous release to switch back to")

        scripts = self.update_host_scripts(sha)
        claude_md = self.update_claude_md(sha)
        self.ledger(
            {
                "action": "deploy",
                "sha": sha,
                "ref": ref,
                "host_scripts_updated": scripts,
                "claude_md_updated": claude_md,
                "wheel_sha256": wheel_sha,
                "previous": previous,
                "migrations_applied": migrated,
                "backup": backup or None,
                "law_applied": law_changed,
                "merged_by": self.options.merged_by,
                "units": units,
                "at": switched_at.isoformat(),
                "by": os.environ.get("SUDO_USER", "root"),
            }
        )
        self.say(f"live: {sha} ({len(units)} units verified)")
        return 0

    def rollback(self) -> int:
        current = self.current_sha()
        if current is None:
            raise Refused("no current release")
        entry = next(
            (e for e in reversed(self.ledger_entries()) if e.get("sha") == current),
            None,
        )
        if entry is None or not entry.get("previous"):
            raise Refused(f"no previous release recorded for {current[:12]}")
        target = str(entry["previous"])
        if entry.get("migrations_applied"):
            raise Refused(
                f"migrations {entry['migrations_applied']} lie between {target[:12]} and "
                f"{current[:12]}; backup {entry.get('backup')}. A symlink does not roll back a database."
            )
        if not (self.layout.releases / target).is_dir():
            raise Refused(f"release {target[:12]} is no longer installed")
        units = self.units()
        expect = self.alive_workers()
        law_changed = self.sync_law(target, current, current, "rollback")
        switched_at = self.host.now()
        self.switch_current(target)
        self.restart(units)
        failure = self.verify_units(units, expect, switched_at)
        if failure:
            if law_changed:
                self.sync_law(current, target, current, "law put back")
            self.switch_current(current)
            self.restart(units)
            raise Refused(f"{failure}; switched back to {current[:12]}")
        self.ledger(
            {
                "action": "rollback",
                "sha": target,
                "previous": current,
                "migrations_applied": [],
                "units": units,
                "at": switched_at.isoformat(),
                "by": os.environ.get("SUDO_USER", "root"),
            }
        )
        self.say(f"rolled back to {target}")
        return 0


def main(argv: list[str] | None = None, host: Host | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="core-deploy", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument(
        "ref", nargs="?", help="tag or full commit sha on upstream develop"
    )
    parser.add_argument(
        "--migrate", action="store_true", help="apply pending migrations"
    )
    parser.add_argument(
        "--rollback", action="store_true", help="return to the previous release"
    )
    parser.add_argument(
        "--merged-by",
        help="who merged the commit on GitHub (the post-merge runner passes it)",
    )
    parser.add_argument(
        "--host-setup-applied",
        action="store_true",
        help="the governor applied this commit's host setup; deploy it anyway",
    )
    parser.add_argument(
        "--tested-as",
        help="the pull-request head CI tested; the commit's tree must equal it",
    )
    parser.add_argument(
        "--root", type=Path, default=Path("/opt/core"), help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--sbin", type=Path, default=Path("/usr/local/sbin"), help=argparse.SUPPRESS
    )
    args = parser.parse_args(argv)
    if bool(args.ref) == bool(args.rollback):
        parser.error("give exactly one of <ref> or --rollback")
    if host is None and os.geteuid() != 0:
        print("core-deploy: must run as root (sudo core-deploy ...)", file=sys.stderr)
        return EX_REFUSED

    layout = Layout(args.root, args.sbin)
    deployer = Deployer(
        host or Host(),
        layout,
        Options(
            migrate=args.migrate,
            merged_by=args.merged_by,
            tested_as=args.tested_as,
            host_setup_applied=args.host_setup_applied,
        ),
    )
    layout.root.mkdir(parents=True, exist_ok=True)
    with layout.lock.open("a") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("core-deploy: another deployment is running", file=sys.stderr)
            return EX_REFUSED
        try:
            return deployer.rollback() if args.rollback else deployer.deploy(args.ref)
        except Refused as exc:
            print(f"core-deploy: refused: {exc}", file=sys.stderr)
            return EX_REFUSED
        except GovernorDecision as exc:
            print(
                f"core-deploy: STOPPED, governor decision needed: {exc}",
                file=sys.stderr,
            )
            return EX_GOVERNOR


if __name__ == "__main__":
    sys.exit(main())
