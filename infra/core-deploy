def latest_runs(runs: list[dict]) -> list[dict]:
    """The newest run of each check: a re-run supersedes the run before it.

    GitHub keeps every run of a check on a commit (a PR description edit
    re-runs host-change-stated), and run ids increase. A check is its name
    within one app; runs without a name or an id are each kept.
    """
    latest: dict[object, dict] = {}
    for i, run in enumerate(runs):
        name, run_id = run.get("name"), run.get("id")
        app = (run.get("app") or {}).get("id")
        key: object = (app, name)
        if name is None or not isinstance(run_id, int):
            key = ("unnamed", i)
        if key not in latest or run_id > latest[key]["id"]:
            latest[key] = run
    return list(latest.values())


def required_checks(rules: object) -> list[tuple[str, int | None]]:
    """(name, app id or None) of every status check GitHub's rules for a
    branch require (GET /repos/{repo}/rules/branches/{branch}: every ruleset
    that applies, readable without a token on a public repository), less
    PULL_REQUEST_ONLY."""
    required: list[tuple[str, int | None]] = []
    for rule in rules if isinstance(rules, list) else []:
        if not isinstance(rule, dict) or rule.get("type") != "required_status_checks":
            continue
        for check in (rule.get("parameters") or {}).get("required_status_checks", []):
            name, app = check.get("context"), check.get("integration_id")
            if name and name not in PULL_REQUEST_ONLY:
                required.append((str(name), app if isinstance(app, int) else None))
    return sorted(set(required), key=str)


def unmet_required(
    runs: list[dict], required: list[tuple[str, int | None]]
) -> list[str]:
    """Each required check without a green newest run, with why. A run counts
    only under the exact name and, when the rule names one, from that app
    (another app cannot stand in for GitHub Actions). Skipped and neutral
    count as passing, as GitHub counts them for a required check."""
    unmet = []
    for name, app in required:
        mine = [
            r
            for r in runs
            if r.get("name") == name
            and (app is None or (r.get("app") or {}).get("id") == app)
        ]
        if not mine:
            unmet.append(f"{name}: missing")
        elif not any(
            r.get("status") == "completed" and r.get("conclusion") in GREEN
            for r in mine
        ):
            r = mine[0]
            unmet.append(f"{name}: {r.get('status')}/{r.get('conclusion')}")
    return unmet


def read_env_file(path: Path) -> dict[str, str]:
    """KEY=VALUE lines (systemd EnvironmentFile subset); comments ignored."""
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def parse_row_counts(out: bytes) -> dict[str, int]:
    """ROW_COUNT_SQL's "schema.table|rows" lines; other lines are skipped."""
    counts: dict[str, int] = {}
    for line in out.decode(errors="replace").splitlines():
        table, sep, rows = line.strip().rpartition("|")
        if sep and table and rows.isdigit():
            counts[table] = int(rows)
    return counts


def github_slug(url: str) -> str:
    match = re.fullmatch(r"https://github\.com/([\w.-]+/[\w.-]+?)(?:\.git)?/?", url)
    if not match:
        raise Refused(f"CORE_UPSTREAM_URL is not an https GitHub URL: {url!r}")
    return match.group(1)


def valid_ref(ref: str) -> bool:
    return bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", ref)) and ".." not in ref


def requirements_from_lock(lock_bytes: bytes) -> str:
    """Every locked package, pinned with all its file hashes.

    All groups: the services run the audit tools (mypy, ruff) that live in
    the dev group, exactly as today's venv does. pip evaluates markers.
    """
    lock = tomllib.loads(lock_bytes.decode())
    lines = []
    for package in lock.get("package", []):
        hashes = [f["hash"] for f in package.get("files", []) if f.get("hash")]
        if not hashes:
            raise Refused(f"poetry.lock has no hashes for {package['name']}")
        spec = f"{package['name']}=={package['version']}"
        if package.get("markers") and isinstance(package["markers"], str):
            spec += f" ; {package['markers']}"
        lines.append(spec + "".join(f" \\\n    --hash={h}" for h in hashes))
    return "\n".join(lines) + "\n"


def verify_wheel(wheel: Path, archive: bytes, pyproject: bytes) -> None:
    """The wheel holds exactly bytes from src/, the declared scripts, no .pth."""
    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
        source = {
            m.name: tar.extractfile(m).read()  # type: ignore[union-attr]
            for m in tar.getmembers()
            if m.isfile() and m.name.startswith("src/")
        }
    declared = tomllib.loads(pyproject.decode()).get("project", {}).get("scripts", {})
    problems: list[str] = []
    with zipfile.ZipFile(wheel) as zf:
        for name in zf.namelist():
            if name.endswith("/"):
                continue
            if name.endswith(".pth"):
                problems.append(f"{name}: .pth file")
                continue
            top = name.split("/", 1)[0]
            if top.endswith(".dist-info"):
                if name.endswith("/entry_points.txt"):
                    scripts = _console_scripts(zf.read(name).decode())
                    if scripts != declared:
                        problems.append(
                            f"console scripts {scripts} != pyproject {declared}"
                        )
                continue
            expected = source.get(f"src/{name}")
            if expected is None:
                problems.append(f"{name}: not in the source archive")
            elif zf.read(name) != expected:
                problems.append(f"{name}: differs from src/{name}")
    if problems:
        raise Refused(
            "built wheel does not match the source:\n  " + "\n  ".join(problems[:20])
        )


def _console_scripts(text: str) -> dict[str, str]:
    scripts: dict[str, str] = {}
    section = None
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("["):
            section = line.strip("[]")
        elif section == "console_scripts" and "=" in line:
            key, value = line.split("=", 1)
            scripts[key.strip()] = value.strip()
    return scripts


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _parse_time(value: str | None) -> datetime.datetime | None:
    if not value:
        return None
    parsed = datetime.datetime.fromisoformat(value)
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=datetime.UTC)


