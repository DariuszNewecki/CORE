# ---------------------------------------------------------------------------
# Host: every side effect outside the filesystem goes through here, so the
# tests can replace processes, HTTP and time without touching the logic.
# ---------------------------------------------------------------------------


class Host:
    def run(
        self,
        cmd: list[str],
        *,
        user: str | None = None,
        input: bytes | None = None,
        check: bool = True,
    ) -> subprocess.CompletedProcess[bytes]:
        argv = list(cmd)
        if user:
            # A clean environment with the account's own HOME: root's
            # environment (HOME=/root, sudo's variables) never leaks into
            # core's git or core-build's build backends.
            argv = [
                "runuser",
                "-u",
                user,
                "--",
                "env",
                "-i",
                f"HOME={pwd.getpwnam(user).pw_dir}",
                "PATH=/usr/local/bin:/usr/bin:/bin",
                "LANG=C.UTF-8",
                *cmd,
            ]
        result = subprocess.run(argv, input=input, capture_output=True)
        if check and result.returncode != 0:
            raise Refused(
                f"command failed ({result.returncode}): {' '.join(argv)}\n"
                + result.stderr.decode(errors="replace").strip()
            )
        return result

    def group_members(self, group: str) -> list[str]:
        try:
            return list(grp.getgrnam(group).gr_mem)
        except KeyError:
            return []

    def http_json(self, url: str, timeout: float = 15.0) -> object:
        request = urllib.request.Request(
            url, headers={"Accept": "application/json", "User-Agent": "core-deploy"}
        )
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read().decode())

    def now(self) -> datetime.datetime:
        return datetime.datetime.now(datetime.UTC)

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)

    def chown(self, path: Path, user: str, recursive: bool = False) -> None:
        targets = [path]
        if recursive:
            targets += list(path.rglob("*"))
        for target in targets:
            shutil.chown(target, user, user)

    def process_texts(self) -> list[str]:
        """Every running process's /proc maps and cmdline, as text. A
        process that exits while being read is skipped; an unreadable /proc
        raises, so nothing is pruned blind."""
        texts = []
        for proc in Path("/proc").iterdir():
            if not proc.name.isdigit():
                continue
            for name in ("maps", "cmdline"):
                try:
                    data = (proc / name).read_bytes()
                except (FileNotFoundError, ProcessLookupError):
                    continue
                texts.append(data.replace(b"\0", b" ").decode(errors="replace"))
        return texts


