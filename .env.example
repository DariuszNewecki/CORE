# CORE environment configuration — copy this file to .env:
#     cp .env.example .env
#
# These keys are read by src/shared/config.py via their exact names (single
# underscore, case-sensitive). The defaults below match docker-compose.yml, so
# the bundled Postgres + Qdrant work out of the box.

# --- Database (Postgres) — REQUIRED ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/core
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Vector store (Qdrant) — REQUIRED ---
QDRANT_URL=http://localhost:6333

# --- Models (LLM) ---
# Not set here. Models live in the database: install-core.sh sets them up, or
# run `poetry run core-admin llm-resources setup --write` (see "Configure a
# model" in docs/getting-started.md). Search (vector sync) and code generation
# both need them; the offline audit does not.

# --- Secrets at rest ---
# CORE_MASTER_KEY encrypts stored secrets (a remote model's API key). It lives
# in .secrets/core.env, not here; install-core.sh creates it.

# --- Misc ---
LOG_LEVEL=INFO
CORE_ENV=development
CORE_STRICT_MODE=false
